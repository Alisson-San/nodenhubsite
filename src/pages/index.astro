---
export const prerender = false;

import PublicLayout from "../layouts/PublicLayout.astro";
import Campaigns from "../components/campaigns/Campaigns.astro";
import ClosingCta from "../components/site/ClosingCta.astro";
import NodeStory from "../components/site/NodeStory.astro";
import Journey from "../components/site/Journey.astro";
import HomeEditor from "../components/editor/HomeEditor.astro";

import { getWhatsAppUrl } from "../config/site";
import { loadHomeView } from "../lib/site/homeView";

const { site, content, startingPrices, editor } = await loadHomeView(Astro);
if (editor) Astro.response.headers.set("Cache-Control", "private, no-store");
const whatsappUrl = getWhatsAppUrl(undefined, site);

// Cada etapa da jornada leva a promessa que acontece nela.
const promises = [
	{ title: "Avaliação remota grátis", text: "Foto ou vídeo já mostram o próximo passo." },
	{ title: "Orçamento antes", text: "Nenhum serviço começa sem o seu ok." },
	{ title: "Atendimento no mesmo dia", text: "Chamou cedo, encaixamos na agenda do dia." },
	{ title: "Busca e entrega", text: "Você não precisa sair de casa com o equipamento." },
];

const steps = [
	{ title: "Chame no WhatsApp", text: "Conte o problema. Foto e vídeo ajudam." },
	{ title: "Receba o orçamento", text: "Você aprova antes de qualquer serviço." },
	{ title: "A gente busca", text: "Ou atende aí, no endereço combinado." },
	{ title: "Volta funcionando", text: "Testado e com explicação do que foi feito." },
];
---

<PublicLayout
	site={site}
	title="Noden — assistência técnica, PC gamer e sistemas para empresas em Barão e região"
	description="Suporte de computador em casa, montagem e otimização de PC gamer, dados e sistemas para empresas. Atendimento no mesmo dia, busca e entrega e orçamento antes."
	canonical="/"
	current="start"
	noindex={Boolean(editor)}
>
	{!editor && <Campaigns page="/" />}

	<NodeStory content={content} startingPrices={startingPrices} whatsappUrl={whatsappUrl} areas={site.serviceAreas} editing={Boolean(editor)} />

	<Journey title="Do WhatsApp ao equipamento funcionando." steps={steps} promises={promises} areas={site.serviceAreas} />

	<ClosingCta
		title={content.contactTitle}
		description={content.contactDescription}
		buttonLabel={content.contactLabel}
		buttonHref={whatsappUrl}
		editTarget="home"
	/>

	{editor && <HomeEditor slot="after" state={editor} />}
</PublicLayout>
