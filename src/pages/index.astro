	.noden-symbol {
		position: absolute;
		left: 50%;
		top: 50%;
		width: clamp(300px, 30vw, 500px);
		aspect-ratio: 1;
		transform: translate(-50%, -50%);
		filter: drop-shadow(0 0 42px rgba(33, 133, 255, 0.24));
		z-index: 7;
	}

.noden-symbol svg {
	display: block;
	width: 100%;
	height: 100%;
	overflow: visible;
}

/* CÍRCULOS */
.noden-symbol .module-ring {
	fill: none;
	stroke-width: 92;
	stroke-linecap: round;
	stroke-linejoin: round;
}

.noden-symbol .ring-top {
	stroke: url(#gradTop);
}

.noden-symbol .ring-left {
	stroke: url(#gradLeft);
}

.noden-symbol .ring-right {
	stroke: url(#gradRight);
}

/* CONECTORES */
.noden-symbol .connector-layer {
	opacity: 1;
	pointer-events: none;
}

.noden-symbol .connector-piece {
	transform-box: fill-box;
	transform-origin: center;
}

.noden-symbol .flow {
	fill: none;
	stroke-width: 76;
	stroke-linecap: round;
	stroke-linejoin: round;
	opacity: 0.95;
}

.noden-symbol .flow-main {
	stroke: url(#gradPurpleBlue);
}

.noden-symbol .flow-right {
	stroke: url(#gradRight);
}

.noden-symbol .orbital {
	fill: none;
	stroke-width: 38;
	stroke-linecap: round;
	stroke-linejoin: round;
	opacity: 0.9;
}

.noden-symbol .orbital-left {
	stroke: url(#gradLeft);
}

.noden-symbol .orbital-right {
	stroke: url(#gradRight);
}

.noden-symbol .orbital-bottom {
	stroke: url(#gradPurpleBlue);
}

.noden-symbol .flow {
	fill: none;
	stroke-width: 90;
	stroke-linecap: round;
	stroke-linejoin: round;
	opacity: 0.95;
}
.noden-symbol .flow-main {
	stroke: url(#gradFlowMain);
}

.noden-symbol .flow-right {
	stroke: url(#gradFlowRight);
}
/* ANIMAÇÃO DOS NÓS */
.noden-symbol .node {
	transform-box: fill-box;
	transform-origin: center;
}

/* ÍCONES INTERNOS */
.noden-symbol .node-icon {
	opacity: 0;
	transform: scale(0.45);
	transform-box: fill-box;
	transform-origin: center;
}

.noden-symbol .node-icon path,
.noden-symbol .node-icon circle,
.noden-symbol .node-icon ellipse {
	fill: none;
	stroke: #ffffff;
	stroke-width: 16;
	stroke-linecap: round;
	stroke-linejoin: round;
}


