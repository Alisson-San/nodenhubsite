			timeline.addLabel("inicio", 0);
			timeline.addLabel("quem-somos", 4.5);
			timeline.addLabel("home", 7.28);
			timeline.addLabel("game", 9.82);
			timeline.addLabel("data", 12.35);
			timeline.addLabel("contato", 17.18);

			const menuTargetTimes: Record<string, number> = {
				inicio: 0,

				// Marca, proposta, cidades e três segmentos já visíveis.
				"quem-somos": 5.9,

				// Ícone e painel Home completamente apresentados.
				home: 8.2,

				// Ícone e painel Game completamente apresentados.
				game: 10.75,

				// Ícone e painel Data completamente apresentados.
				data: 13.3,

				// Tratado separadamente para ir ao fim real.
				contato: timeline.duration(),
			};

			const navigationLinks = Array.from(
				document.querySelectorAll<HTMLAnchorElement>(
					"[data-timeline-label]",
				),
			);

			const setActiveNavigation = (activeLabel: string) => {
				navigationLinks.forEach((link) => {
					link.classList.toggle(
						"is-active",
						link.dataset.timelineLabel === activeLabel,
					);
				});
			};

			const getCurrentTimelineLabel = () => {
				const currentTime = timeline.time();
				const orderedLabels = [
					{ name: "inicio", time: timeline.labels.inicio },
					{ name: "quem-somos", time: timeline.labels["quem-somos"] },
					{ name: "home", time: timeline.labels.home },
					{ name: "game", time: timeline.labels.game },
					{ name: "data", time: timeline.labels.data },
					{ name: "contato", time: timeline.labels.contato },
				];

				let currentLabel = "inicio";

				orderedLabels.forEach((label) => {
					if (currentTime >= label.time - 0.25) {
						currentLabel = label.name;
					}
				});

				return currentLabel;
			};

			const scrollToTimelineLabel = (label: string) => {
				const trigger = timeline.scrollTrigger;

				if (!trigger) return;

				const targetTime =
					label === "contato"
						? timeline.duration()
						: menuTargetTimes[label];

				if (typeof targetTime !== "number") return;

				const progress = gsap.utils.clamp(
					0,
					1,
					targetTime / timeline.duration(),
				);

				const destination =
					trigger.start + (trigger.end - trigger.start) * progress;

				/*
				 * Salta diretamente para a cena selecionada,
				 * sem reproduzir visualmente as etapas intermediárias.
				 */
				lenis.scrollTo(destination, {
					immediate: true,
					force: true,
				});

				timeline.time(targetTime, false);
				ScrollTrigger.update();
				setActiveNavigation(label);
			};

			const panels = Array.from(document.querySelectorAll<HTMLElement>("#inicio, #quem-somos, #noden-home, #noden-game, #noden-data, #contato"));
			const syncPanels = () => panels.forEach((panel) => {
				const contentVisible = panel.id !== "contato" || Array.from(panel.querySelectorAll(".final-demand-line, .final-contact-link")).some((item) => Number(getComputedStyle(item).opacity) > 0.5);
				const visible = contentVisible && Number(getComputedStyle(panel).opacity) > 0.5 &&
					(panel.id !== "quem-somos" || Number(getComputedStyle(panel.parentElement!).opacity) > 0.5);
				panel.inert = !visible;
				panel.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => { link.inert = !visible || Number(getComputedStyle(link).opacity) <= 0.5; });
				panel.setAttribute("aria-hidden", String(!visible));
			});
			navigateScene = (hash, focus = false) => {
				const id = hash.slice(1) || "inicio";
				const panel = panels.find((item) => item.id === id);
				if (!panel) return;
				scrollToTimelineLabel(id.replace("noden-", ""));
				syncPanels();
				if (focus) panel.focus({ preventScroll: true });
			};

			timeline.eventCallback("onUpdate", () => {
				setActiveNavigation(getCurrentTimelineLabel());
				syncPanels();
			});

			lenis.on("scroll", (event: { scroll: number }) => {
				header?.classList.toggle("is-scrolled", event.scroll > 24);
				setActiveNavigation(getCurrentTimelineLabel());
			});

			// Editorial text must remain readable when it exceeds the fixed scene.
			const divisionPanels = Array.from(document.querySelectorAll<HTMLElement>(".division-copy"));
			const fitsScene = () => divisionPanels.every((panel) => panel.offsetHeight <= window.innerHeight - 128);
			const contentObserver = new ResizeObserver(() => {
				if (!fitsScene()) context.revert();
			});
			divisionPanels.forEach((panel) => contentObserver.observe(panel));
			const onResize = () => {
				if (!fitsScene()) { context.revert(); return; }
				placeIntroNodes(); ScrollTrigger.refresh();
			};
			window.addEventListener("resize", onResize);
			document.documentElement.classList.remove("experience-preparing");
			const initialFrame = requestAnimationFrame(() => { ScrollTrigger.refresh(); followHash(); syncPanels(); });
			setActiveNavigation("inicio");
			return () => {
				cancelAnimationFrame(initialFrame);
				contentObserver.disconnect();
				window.removeEventListener("resize", onResize);
				gsap.ticker.remove(tick);
				lenis.destroy();
				navigateScene = undefined;
				document.documentElement.classList.remove("experience-animated");
				panels.forEach((panel) => { panel.inert = false; panel.removeAttribute("aria-hidden"); panel.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => { link.inert = false; }); });
				requestAnimationFrame(followHash);
			};
			});
		</script>
