---
export const prerender = false;

import { splitHomeHighlights } from "../lib/site/homeContent";

import SiteFooter from "../components/common/SiteFooter.astro";

import NodenSymbol from "../components/NodenSymbol.astro";
import NodenMarkStatic from "../components/NodenMarkStatic-conectores-visiveis.astro";

import {
	getWhatsAppUrl,
} from "../config/site";

import {
	loadSiteConfig,
} from "../lib/site/siteRepository";

const site = await loadSiteConfig();

const whatsappUrl =
	getWhatsAppUrl(
		undefined,
		site,
	);
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content={site.description}
		/>
		<title>{site.name} — Technology Hub</title>
		<link rel="canonical" href={new URL("/", site.url)} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />

		<script is:inline>
			// Reserve the desktop scene before first paint, with a readable fallback if the bundle fails.
			if (matchMedia("(min-width: 1100px) and (min-height: 550px) and (prefers-reduced-motion: no-preference)").matches) {
				document.documentElement.classList.add("experience-animated", "experience-preparing");
				setTimeout(() => {
					if (!document.documentElement.classList.contains("experience-preparing")) return;
					document.documentElement.classList.remove("experience-animated", "experience-preparing");
					document.documentElement.dataset.animationUnavailable = "true";
					requestAnimationFrame(() => document.getElementById(location.hash.slice(1))?.scrollIntoView());
				}, 2500);
			}
		</script>
		<noscript><style>
			.menu-toggle { display: none !important; }
			.site-header { position: relative !important; height: auto !important; flex-wrap: wrap; gap: 20px; padding: 20px !important; }
			.site-navigation { position: static !important; opacity: 1 !important; visibility: visible !important; transform: none !important; pointer-events: auto !important; padding: 0 !important; max-height: none !important; }
		</style></noscript>
	</head>

	<body>
		<a class="skip-link" href="#inicio">Pular para o conteúdo</a>

		<header id="site-header" class="site-header">
			<a
				href="#inicio"
				class="site-logo"
				data-timeline-label="inicio"
				aria-label="Noden — voltar ao início"
			>
				<span>N</span>

				<span class="site-logo-mark" aria-hidden="true">
					<NodenMarkStatic idPrefix="header-noden-mark" />
				</span>

				<span>DEN</span>
			</a>

			<button
				id="menu-toggle"
				class="menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="site-navigation"
				aria-label="Abrir menu"
			>
				<span></span>
				<span></span>
			</button>

			<nav id="site-navigation" class="site-navigation" aria-label="Navegação principal">
				<a href="#quem-somos" data-timeline-label="quem-somos">Quem somos</a>
				<a href="#noden-home" data-timeline-label="home">Noden Home</a>
				<a href="#noden-game" data-timeline-label="game">Noden Game</a>
				<a href="#noden-data" data-timeline-label="data">Noden Data</a>
				<a href="#contato" class="navigation-contact" data-timeline-label="contato">Contato</a>
			</nav>
		</header>

		<main class="experience">
			<section class="scroll-stage">
				<div class="scene">
					<div class="ambient ambient-one"></div>
					<div class="ambient ambient-two"></div>

					<NodenSymbol />

					<div id="inicio" tabindex="-1" class="copy start-copy">
						<span class="start-kicker">NODEN TECHNOLOGY HUB</span>

						<h1>{site.home.title}</h1>

						<p class="start-message">{site.home.description}</p>
						<div class="start-actions">
							<a class="start-contact" href={whatsappUrl} target="_blank" rel="noopener noreferrer">{site.home.contactLabel}</a>
							<a href="/home">Home · suporte residencial</a>
							<a href="/game">Game · seu setup</a>
							<a href="/data">Data · software e dados</a>
						</div>

					</div>

					<div id="brand-scene" class="brand-scene">
						<div class="brand-lockup" aria-label="NODEN Technology Hub">
							<div class="brand-word">
								<span class="brand-letter brand-letter-n">N</span>
								<span
									id="brand-symbol-slot"
									class="brand-symbol-slot"
									aria-hidden="true"
								></span>
								<span class="brand-letter brand-letter-den">DEN</span>
							</div>

							<span class="brand-subtitle">TECHNOLOGY HUB</span>
						</div>

						<div id="quem-somos" tabindex="-1" class="about-copy">
							<div class="about-marker">
								<span class="about-index">01</span>
								<span class="about-eyebrow">QUEM SOMOS</span>
								<span class="about-line" aria-hidden="true"></span>
							</div>

							<div class="about-content">
								<div class="about-heading">
									<span class="about-kicker">UM HUB. TRÊS FRENTES.</span>

									<h2>{site.home.aboutTitle}</h2>
									<p class="about-lead">{site.home.aboutDescription}</p>
									<div
										class="about-coverage"
										aria-label="Cidades com atendimento domiciliar"
									>
										<span class="coverage-label">ATENDIMENTO DOMICILIAR</span>

										<div class="coverage-cities">
											{
												site.serviceAreas.map(
													(area) => (
														<span>{area}</span>
													),
												)
											}
										</div>
									</div>
								</div>

								<div class="about-services" aria-label="Segmentos da Noden">
									<article class="service-card service-home">
										<span class="service-number">01</span>
										<h3>Noden Home</h3>
										<p>
											Suporte, manutenção, upgrades e soluções para a
											tecnologia do dia a dia.
										</p>
									</article>

									<article class="service-card service-game">
										<span class="service-number">02</span>
										<h3>Noden Game</h3>
										<p>
											Montagem, otimização e upgrades para setups que precisam
											entregar mais.
										</p>
									</article>

									<article class="service-card service-data">
										<span class="service-number">03</span>
										<h3>Noden Data</h3>
										<p>
											Engenharia de dados, BI, analytics e soluções de software para transformar
											informação em decisão.
										</p>
									</article>
								</div>
							</div>
						</div>
					</div>


					<div class="division-shell">
						<div id="noden-home" tabindex="-1" class="copy division-copy division-home">
							<span class="division-kicker">NODEN HOME</span>
							<h2>{site.home.homeTitle}</h2>
							<p class="division-lead">{site.home.homeDescription}</p>

							<ul class="division-list">{splitHomeHighlights(site.home.homeHighlights).map((item) => <li>{item}</li>)}</ul>

							<p class="division-meta">{site.home.homeMeta}</p>

							<a
								class="division-link"
								href="/home"
								aria-label="Ver serviços e preços da Noden Home"
							>
								Ver serviços e preços

								<svg
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path
										d="M5 12h14M13 6l6 6-6 6"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</a>
						</div>
					</div>

					<div class="division-shell">
						<div id="noden-game" tabindex="-1" class="copy division-copy division-game">
							<span class="division-kicker">NODEN GAME</span>
							<h2>{site.home.gameTitle}</h2>
							<p class="division-lead">{site.home.gameDescription}</p>

							<ul class="division-list">{splitHomeHighlights(site.home.gameHighlights).map((item) => <li>{item}</li>)}</ul>

							<p class="division-meta">{site.home.gameMeta}</p>

							<a
								class="division-link"
								href="/game"
								aria-label="Ver serviços e preços da Noden Game"
							>
								Ver serviços e preços

								<svg
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path
										d="M5 12h14M13 6l6 6-6 6"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</a>
						</div>
					</div>

					<div class="division-shell">
						<div id="noden-data" tabindex="-1" class="copy division-copy division-data">
							<span class="division-kicker">NODEN DATA</span>
							<h2>{site.home.dataTitle}</h2>
							<p class="division-lead">{site.home.dataDescription}</p>

							<ul class="division-list">{splitHomeHighlights(site.home.dataHighlights).map((item) => <li>{item}</li>)}</ul>

							<p class="division-meta">{site.home.dataMeta}</p>

							<a
								class="division-link"
								href="/data"
								aria-label="Ver serviços e preços da Noden Data"
							>
								Ver serviços e preços

								<svg
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path
										d="M5 12h14M13 6l6 6-6 6"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</a>
						</div>
					</div>

					<div id="contato" tabindex="-1" class="copy final-copy">
						<div class="final-demand">
							<h2><span class="final-demand-line final-demand-line-one">{site.home.contactTitle}</span></h2>
							<p class="contact-description final-demand-line final-demand-line-two">{site.home.contactDescription}</p>
						</div>

						<div class="final-brand-lockup" aria-label="NODEN">
							<span class="final-brand-letter final-brand-letter-n">N</span>

							<span
								id="final-symbol-slot"
								class="final-symbol-slot"
								aria-hidden="true"
							></span>

							<span class="final-brand-letter final-brand-letter-den">DEN</span>
						</div>

						<a
							href={whatsappUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="final-contact-link"
						>
							<span class="final-contact-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" role="img">
									<path
										d="M 20.52 3.48 A 11.92 11.92 0 0 0 12.04 0 C 5.42 0 0.04 5.38 0.04 12 C 0.04 14.12 0.6 16.19 1.65 18.01 L 0 24 L 6.15 22.39 A 11.99 11.99 0 0 0 12.04 24 C 18.66 24 24.04 18.62 24.04 12 A 11.92 11.92 0 0 0 20.52 3.48 Z M 12.04 21.88 A 9.9 9.9 0 0 1 7 20.5 L 6.64 20.29 L 2.99 21.24 L 3.97 17.68 L 3.73 17.31 A 9.86 9.86 0 1 1 12.04 21.88 Z"
									/>
									<path
										d="M 17.75 14.87 C 17.47 14.73 16.1 14.06 15.85 13.97 C 15.59 13.87 15.41 13.83 15.22 14.11 C 15.04 14.38 14.51 15.01 14.35 15.19 C 14.19 15.37 14.03 15.39 13.74 15.24 C 12.02 14.39 10.89 13.72 9.75 11.76 C 9.45 11.24 10.05 11.27 10.61 10.15 C 10.7 9.97 10.66 9.82 10.59 9.68 C 10.52 9.54 9.96 8.17 9.73 7.62 C 9.5 7.09 9.27 7.16 9.1 7.15 C 8.94 7.14 8.75 7.14 8.57 7.14 C 8.39 7.14 8.09 7.21 7.83 7.49 C 7.57 7.76 6.84 8.44 6.84 9.81 C 6.84 11.18 7.86 12.51 8 12.7 C 8.14 12.88 10 15.91 12.86 17.14 C 15.69 18.35 15.69 17.95 16.17 17.91 C 16.64 17.86 17.71 17.24 17.92 16.65 C 18.14 16.05 18.14 15.54 18.06 15.4 C 17.99 15.26 17.82 15.01 17.75 14.87 Z"
									/>
								</svg>
							</span>

							<span>{site.home.contactLabel}</span>
						</a>
					</div>

					<div class="scroll-hint">
						<span>SCROLL</span>
						<div></div>
					</div>
				</div>
			</section>

		</main>
		<SiteFooter site={site} logoIdPrefix="landing-footer" />

		<script is:inline>
			const header = document.querySelector("#site-header");
			const menuToggle = document.querySelector("#menu-toggle");
			const menu = document.querySelector("#site-navigation");
			const mobileMenu = window.matchMedia("(max-width: 800px)");
			const setMenu = (open) => {
				header?.classList.toggle("is-menu-open", open);
				menuToggle?.setAttribute("aria-expanded", String(open));
				menuToggle?.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
				if (menu) menu.inert = mobileMenu.matches && !open;
			};
			menuToggle?.addEventListener("click", () => setMenu(menuToggle.getAttribute("aria-expanded") !== "true"));
			header?.addEventListener("keydown", (event) => {
				if (event.key === "Escape") { setMenu(false); menuToggle?.focus(); }
			});
			header?.addEventListener("focusout", () => {
				requestAnimationFrame(() => { if (!header.contains(document.activeElement)) setMenu(false); });
			});
			mobileMenu.addEventListener("change", () => setMenu(false));
			setMenu(false);

 document.querySelectorAll('a[href^="#"]').forEach((link) => link.addEventListener("click", () => setMenu(false)));
 window.addEventListener("scroll", () => header?.classList.toggle("is-scrolled", scrollY > 24), { passive: true });
		</script>

		<script>
			import gsap from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";
			import Lenis from "lenis";

			gsap.registerPlugin(ScrollTrigger);

			let navigateScene: ((hash: string, focus?: boolean) => void) | undefined;
			const header = document.querySelector<HTMLElement>("#site-header");
			document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
				link.addEventListener("click", (event) => {
					if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
					if (navigateScene) {
						event.preventDefault();
						if (location.hash !== link.hash) history.pushState(null, "", link.hash);
						navigateScene(link.hash, true);
					}
				});
			});
			const followHash = () => {
				if (navigateScene) navigateScene(location.hash);
				else if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView();
			};
			document.fonts.ready.then(() => requestAnimationFrame(followHash));
			window.addEventListener("hashchange", followHash);
			window.addEventListener("popstate", followHash);

			gsap.matchMedia().add("(min-width: 1100px) and (min-height: 550px) and (prefers-reduced-motion: no-preference)", (context) => {
			if (document.documentElement.dataset.animationUnavailable === "true") return;
			document.documentElement.classList.add("experience-animated");

			const lenis = new Lenis({
				duration: 0.82,
				smoothWheel: true,
			});

			lenis.on("scroll", ScrollTrigger.update);

			const tick = (time: number) => lenis.raf(time * 1000);
			gsap.ticker.add(tick);

			gsap.ticker.lagSmoothing(0);

			const prefersReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			const introIdleTargets = [
				"#idle-home",
				"#idle-game",
				"#idle-data",
			];

			let introIdleActive = false;
			let introIdleTweens: gsap.core.Tween[] = [];

			gsap.set(introIdleTargets, {
				x: 0,
				y: 0,
				scale: 1,
				transformOrigin: "50% 50%",
			});

			const startIntroIdle = () => {
				if (prefersReducedMotion || introIdleActive) return;

				introIdleActive = true;

				introIdleTweens = [
					gsap.to("#idle-home", {
						x: 10,
						y: -9,
						scale: 1.02,
						duration: 1.8,
						repeat: -1,
						yoyo: true,
						ease: "sine.inOut",
					}),

					gsap.to("#idle-game", {
						x: -11,
						y: 8,
						scale: 1.018,
						duration: 1.6,
						repeat: -1,
						yoyo: true,
						ease: "sine.inOut",
					}),

					gsap.to("#idle-data", {
						x: 11,
						y: 11,
						scale: 1.02,
						duration: 1.9,
						repeat: -1,
						yoyo: true,
						ease: "sine.inOut",
					}),
				];
			};

			const stopIntroIdle = () => {
				if (!introIdleActive) return;

				introIdleActive = false;

				introIdleTweens.forEach((tween) => tween.kill());
				introIdleTweens = [];

				// Reset imediato para não desalinha os conectores
				// caso a pessoa role rapidamente.
				gsap.set(introIdleTargets, {
					x: 0,
					y: 0,
					scale: 1,
				});
			};

			const timeline = gsap.timeline({
				scrollTrigger: {
					trigger: ".scroll-stage",
					start: "top top",
					end: "bottom bottom",
					/*
					 * O Lenis já suaviza a rolagem.
					 * scrub:true evita um segundo atraso em cima do scroll.
					 */
					scrub: true,
					invalidateOnRefresh: true,

					onUpdate: (self) => {
						if (self.progress <= 0.001) {
							startIntroIdle();
						} else {
							stopIntroIdle();
						}
					},
				},
			});

			gsap.set(".node-icon", {
				opacity: 0,
				scale: 0.5,
			});

			gsap.set(".copy:not(#inicio)", {
				opacity: 0,
				y: 50,
			});

			gsap.set("#inicio", {
				opacity: 1,
				y: 0,
			});

			gsap.set("#brand-scene", {
				opacity: 1,
				y: 0,
			});

			gsap.set(".brand-letter-n", {
				opacity: 0,
				x: -70,
			});

			gsap.set(".brand-letter-den", {
				opacity: 0,
				x: 70,
			});

			gsap.set(".brand-subtitle", {
				opacity: 0,
				y: 14,
			});

			gsap.set("#quem-somos .about-marker > *", {
				opacity: 0,
				x: -18,
			});

			gsap.set("#quem-somos .about-heading > *", {
				opacity: 0,
				y: 24,
			});

			gsap.set("#quem-somos .service-card", {
				opacity: 0,
				y: 24,
			});

			gsap.set("#brand-symbol", {
				scale: 1,
				x: 0,
				y: 0,
				rotation: 0,
			});

			const connectorPaths = gsap.utils.toArray<SVGPathElement>(
				"#connector-layer .flow",
			);

			gsap.set("#connector-layer", {
				opacity: 1,
			});

			connectorPaths.forEach((path) => {
				const length = path.getTotalLength();

				gsap.set(path, {
					opacity: 0,
					strokeDasharray: length,
					strokeDashoffset: length,
				});
			});


			const placeIntroNode = (
				selector: string,
				targetX: number,
				targetY: number,
				scale: number,
				rotation: number,
			) => {
				const node = document.querySelector<SVGGElement>(selector);
				const ring = node?.querySelector<SVGGeometryElement>(".module-ring");

				if (!node || !ring) return;

				gsap.set(node, { x: 0, y: 0, scale, rotation });
				const bounds = ring.getBoundingClientRect();
				const svg = node.ownerSVGElement;
				const unitScale = svg ? svg.getBoundingClientRect().width / svg.viewBox.baseVal.width : 1;
				gsap.set(node, {
					x: (targetX - bounds.left - bounds.width / 2) / unitScale,
					y: (targetY - bounds.top - bounds.height / 2) / unitScale,
				});
			};

			const placeIntroNodes = () => {
				const mobile = window.innerWidth <= 800;
				const nodeScale = mobile ? 0.4 : 0.68;
				const bottomY = window.innerHeight * (mobile ? 0.86 : 0.8);

				placeIntroNode(
					"#node-home",
					window.innerWidth * 0.5,
					window.innerHeight * (mobile ? 0.12 : 0.18),
					nodeScale,
					mobile ? -8 : -16,
				);

				placeIntroNode(
					"#node-game",
					window.innerWidth * (mobile ? 0.17 : 0.08),
					bottomY,
					nodeScale,
					mobile ? 8 : 14,
				);

				placeIntroNode(
					"#node-data",
					window.innerWidth * (mobile ? 0.83 : 0.92),
					bottomY,
					nodeScale,
					mobile ? -8 : -14,
				);
			};

			placeIntroNodes();
			startIntroIdle();

			const brandSymbol =
				document.querySelector<HTMLElement>("#brand-symbol");
			const brandSymbolSlot =
				document.querySelector<HTMLElement>("#brand-symbol-slot");

			const getBrandSymbolTarget = () => {
				if (!brandSymbol || !brandSymbolSlot) {
					return { x: 0, y: 0, scale: 0.25 };
				}

				const slotBounds = brandSymbolSlot.getBoundingClientRect();
				const symbolWidth = brandSymbol.offsetWidth || 1;

				return {
					x:
						slotBounds.left +
						slotBounds.width / 2 -
						window.innerWidth / 2,
					y:
						slotBounds.top +
						slotBounds.height / 2 -
						window.innerHeight / 2,
					scale: slotBounds.width / symbolWidth,
				};
			};

			const getDivisionSymbolState = () => {
				const mobile = window.innerWidth <= 800;

				return {
					x: mobile ? 0 : -205,
					y: mobile ? -window.innerHeight * 0.28 : 42,
					scale: mobile ? 0.78 : 1.42,
				};
			};

			const finalSymbolSlot =
				document.querySelector<HTMLElement>("#final-symbol-slot");

			const getFinalIntroSymbolState = () => {
				const mobile = window.innerWidth <= 800;

				return {
					x: 0,
					y: mobile ? -188 : -178,
					scale: mobile ? 0.19 : 0.22,
				};
			};

			const getFinalSymbolTarget = () => {
				if (!brandSymbol || !finalSymbolSlot) {
					return { x: 0, y: 0, scale: 0.28 };
				}

				const slotBounds = finalSymbolSlot.getBoundingClientRect();
				const symbolWidth = brandSymbol.offsetWidth || 1;

				return {
					x:
						slotBounds.left +
						slotBounds.width / 2 -
						window.innerWidth / 2,
					y:
						slotBounds.top +
						slotBounds.height / 2 -
						window.innerHeight / 2,
					scale: slotBounds.width / symbolWidth,
				};
			};

			gsap.set(".division-copy", {
