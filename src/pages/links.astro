---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import SiteLogo from "../components/common/SiteLogo.astro";
import WhatsAppIcon from "../components/common/WhatsAppIcon.astro";
import DivisionMark from "../components/common/DivisionMark.astro";
import SocialIcon from "../components/common/SocialIcon.astro";
import { buildLinkItems } from "../data/links";
import { loadSiteConfig } from "../lib/site/siteRepository";
import { divisionOrder, divisions } from "../lib/site/divisions";

const site = await loadSiteConfig();
const [whatsapp, ...contacts] = buildLinkItems(site).filter((item) => item.href !== "/");
---

<BaseLayout
	site={site}
	title="Links — Noden"
	description="WhatsApp, Instagram e as três divisões da Noden: suporte em casa, PC gamer e sistemas para empresas."
	canonical="/links"
>
	<div class="page" data-theme="hub">
	<main class="links wrap" id="conteudo">
		<SiteLogo size="lg" idPrefix="links-logo" />
		<p class="links__pitch">A gente busca, resolve e devolve funcionando. {site.serviceAreas.join(" · ")}.</p>

		{
			whatsapp && (
				<a class="btn btn--whatsapp links__main" href={whatsapp.href} target="_blank" rel="noopener">
					<WhatsAppIcon />
					{whatsapp.title}
				</a>
			)
		}

		<nav aria-label="Divisões" class="links__list">
			{
				divisionOrder.map((id) => (
					<a class="link-row" href={divisions[id].path} data-division={id}>
						<DivisionMark division={id} size={48} />
						<span>
							<strong>{divisions[id].name}</strong>
							<small>{divisions[id].pitch}</small>
						</span>
					</a>
				))
			}
		</nav>

		<ul class="links__list" role="list">
			{
				contacts.map((item) => (
					<li>
						<a class="link-row link-row--plain" href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener" : undefined}>
							<span class="link-row__icon"><SocialIcon platform={item.icon} /></span>
							<span>
								<strong>{item.title}</strong>
								<small>{item.description}</small>
							</span>
						</a>
					</li>
				))
			}
			<li>
				<a class="link-row link-row--plain" href="/">
					<span class="link-row__icon"><SocialIcon platform="website" /></span>
					<span>
						<strong>Site completo</strong>
						<small>{site.url.replace(/^https?:\/\//, "")}</small>
					</span>
				</a>
			</li>
		</ul>
	</main>
	</div>
</BaseLayout>

<style>
	.links {
		max-width: 560px;
		min-height: 100dvh;
		display: grid;
		align-content: start;
		justify-items: center;
		gap: 18px;
		padding-block: 48px 64px;
		text-align: center;
	}
	.links__pitch {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.2;
		max-width: 26ch;
	}
	.links__main {
		width: 100%;
		min-height: 60px;
		font-size: 1.1rem;
		margin-top: 6px;
	}
	.links__list {
		width: 100%;
		display: grid;
		gap: 12px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.link-row {
		display: flex;
		align-items: center;
		gap: 16px;
		min-height: 72px;
		padding: 14px 18px;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--text);
		text-align: left;
		text-decoration: none;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}
	.link-row:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--accent) 50%, transparent);
		box-shadow: 0 16px 40px -18px var(--accent);
	}
	.link-row__icon {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		flex: none;
		border-radius: 50%;
		background: var(--surface-2);
		border: 1px solid var(--line);
	}
	.link-row strong {
		display: block;
		font-family: var(--font-display);
		font-size: 1.2rem;
	}
	.link-row small {
		display: block;
		color: var(--text-2);
		font-size: 0.92rem;
	}

</style>
