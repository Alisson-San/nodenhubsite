---
export const prerender=false;
import {loadSiteConfig} from '../../lib/site/siteRepository';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ProductDetails from '../../components/catalog/ProductDetails.astro';
import {loadProductBySlug} from '../../lib/catalog/productRepository';
const site=await loadSiteConfig();
const product=await loadProductBySlug(Astro.params.slug||'');
Astro.response.headers.set('Cache-Control','no-store');
if(!product)Astro.response.status=404;
---
{product?<ServiceLayout site={site} title={product.item.name+' | Noden'} description={product.detail.summary||product.item.description} canonical={'/produtos/'+product.detail.slug} division={product.page.division} accent={product.page.theme.accent} accentSecondary={product.page.theme.accentSecondary}><div class="product-page"><a class="back" href={'/'+product.page.division+'#precos'}>← Voltar ao catálogo</a><ProductDetails site={site} item={product.item} detail={product.detail} division={product.page.division} headingLevel="h1"/></div></ServiceLayout>:<ServiceLayout site={site} title="Produto não encontrado | Noden" description="Este produto não está disponível." canonical="/produtos" division="data"><div class="product-page"><h1>Produto não encontrado</h1><p>Este endereço não está disponível ou o produto ainda não foi publicado.</p><a class="back" href="/data">Conhecer a Noden Data</a></div></ServiceLayout>}
<style>.product-page{width:min(100% - 32px,1000px);margin:0 auto;padding:130px 0 80px}.back{display:inline-flex;min-height:44px;align-items:center;color:#b9d9ff;margin-bottom:28px}</style>
