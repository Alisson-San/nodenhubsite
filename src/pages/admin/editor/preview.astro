---
export const prerender = false;
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Catalog from '../../../components/site/Catalog.astro';
import Solutions from '../../../components/site/Solutions.astro';
import ProductDetails from '../../../components/catalog/ProductDetails.astro';
import { validateCatalogDocument } from '../../../lib/catalog/editorValidation';
import type { CatalogDocument } from '../../../lib/catalog/editorTypes';
import { resolveProductMedia } from '../../../lib/catalog/productRepository';
import { createSupabaseRequestClient } from '../../../lib/supabase/request';
import { loadSiteConfig } from '../../../lib/site/siteRepository';
import type { PricingItem } from '../../../types/services';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
if(!Astro.locals.isAdmin || Astro.request.method!=='POST' || Astro.request.headers.get('Origin')!==Astro.url.origin) return new Response('Prévia disponível somente pelo editor autenticado.',{status:403});
let input:{document:CatalogDocument;selected?:string;kind?:string};
try { const raw=await Astro.request.text(); if(raw.length>2_000_000) return new Response('Conteúdo muito grande.',{status:413}); input=JSON.parse(raw); } catch {return new Response('Documento inválido.',{status:400});}
const issues=validateCatalogDocument(input.document);
if(Object.keys(issues).length) return new Response(Object.entries(issues).map(([k,v])=>k+': '+v).join('\n'),{status:422});
const doc=input.document;
const client=createSupabaseRequestClient({request:Astro.request,cookies:Astro.cookies});
const pageId=doc.items[0]?.service_page_id??doc.serviceCards[0]?.service_page_id;
const [categories,tiers,badges,site]=await Promise.all([
 client.from('catalog_categories').select('*').eq('service_page_id',pageId??'00000000-0000-0000-0000-000000000000'),
 client.from('catalog_tiers').select('*'),client.from('catalog_badges').select('*'),loadSiteConfig()
]);
const details=Object.fromEntries(await Promise.all(Object.entries(doc.details).map(async([id,d])=>[id,await resolveProductMedia(d,client)])));
const items:PricingItem[]=doc.items.filter(x=>x.is_active || x.id===input.selected).map(x=>{
 const category=categories.data?.find(c=>c.id===x.category_id),tier=tiers.data?.find(t=>t.id===x.tier_id);
 return {id:x.id,name:x.name,description:x.description,itemKind:x.item_kind,price:x.price,compareAtPrice:x.compare_at_price,
 pricePrefix:x.price_prefix??(x.price_type==='starting_at'?'A partir de':undefined),
 priceLabel:x.price_label??(x.price_type==='free'?'Sem custo':x.price_type==='consultation'?'Sob consulta':undefined),
 priceSuffix:x.price_suffix??undefined,features:Array.isArray(x.features)?x.features.filter((f):f is string=>typeof f==='string'):[],
 category:category?{id:category.id,name:category.name,slug:category.slug,description:category.description??undefined,color:category.color,iconKey:category.icon_key??undefined}:undefined,
 tier:tier?{id:tier.id,name:tier.name,slug:tier.slug,description:tier.description??undefined,color:tier.color}:undefined,
 badges:(badges.data??[]).filter(b=>x.badge_ids.includes(b.id)).map(b=>({id:b.id,name:b.name,slug:b.slug,iconKey:b.icon_key??undefined,textColor:b.text_color,backgroundColor:b.background_color,borderColor:b.border_color})),
 featured:x.is_featured,note:x.note??undefined,ctaLabel:x.cta_label??undefined,ctaMessage:x.cta_message??undefined};
});
const selected=items.find(x=>x.id===input.selected);
const services=doc.serviceCards.filter(x=>x.is_active||x.id===input.selected).map(x=>({title:x.title,description:x.description,badge:x.badge??undefined,features:Array.isArray(x.features)?x.features.filter((f):f is string=>typeof f==='string'):[]}));
---
<PublicLayout site={site} division={doc.division} title="Prévia privada" description="Prévia administrativa" canonical="/admin/editor" noindex stickyCta={false}>
 <div class="preview-note">Prévia não publicada · {doc.division} · inclui o card selecionado mesmo se oculto</div>
 {input.kind==='serviceCards'?<Solutions title="Soluções" description="Prévia dos cards de soluções." services={services}/>:<>
 {selected&&details[selected.id!]?<section class="wrap detail-preview"><ProductDetails site={site} item={selected} detail={details[selected.id!]} division={doc.division} headingLevel="h1" /></section>:null}
 <Catalog site={site} division={doc.division} title="Catálogo" items={items} details={details}/>
 </>}
</PublicLayout>
<style>.preview-note{padding:14px;text-align:center;background:var(--ink);color:var(--white);font-weight:700}.detail-preview{padding-block:40px}</style>
