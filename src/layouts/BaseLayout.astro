---
import "../styles/noden.css";
import { siteConfig as fallbackSiteConfig } from "../config/site";
import type { RuntimeSiteConfig } from "../types/site";

interface Props {
	site?: RuntimeSiteConfig;
	title?: string;
	description?: string;
	canonical?: string;
	themeColor?: string;
	noindex?: boolean;
}

const {
	site = fallbackSiteConfig,
	title = `${site.name} — tecnologia resolvida para casa, setup e empresa`,
	description = site.description,
	canonical,
	themeColor = "#f6f5fa",
	noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site.url);
const ogImage = new URL("/android-chrome-512x512.png", site.url);
---

<!doctype html>
<html lang={site.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content={themeColor} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary" />

		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Revelação ao rolar decidida antes da primeira pintura; se o script
		     principal não carregar, tudo volta a aparecer em 3 s. -->
		<script is:inline>
			(function () {
				var root = document.documentElement;
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
				root.classList.add("js-reveal");
				setTimeout(function () {
					if (!root.classList.contains("reveal-ready")) root.classList.remove("js-reveal");
				}, 3000);
			})();
		</script>
		<slot name="head" />
	</head>

	<body>
		<slot />
	</body>
</html>
