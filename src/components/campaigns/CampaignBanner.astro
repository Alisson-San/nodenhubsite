---
import type {Campaign} from '../../lib/campaigns/types';
interface Props {campaign:Campaign; topOffset?:boolean}
const {campaign:c}=Astro.props;
---
<aside class="campaign-banner" style={Astro.props.topOffset ? "margin-top:6rem" : undefined} aria-label="Destaque Noden">
 {c.imageUrl&&<img src={c.imageUrl} alt={c.imageAlt} width="280" height="180" loading="lazy" />}
 <div><span class="eyebrow">Em destaque</span><h2>{c.title}</h2><p>{c.description}</p><a href={c.href} rel={c.href.startsWith('https:')?'noopener noreferrer':undefined}>{c.buttonLabel} <span aria-hidden="true">↗</span></a></div>
</aside>
<style>
.campaign-banner{position:relative;z-index:2;display:flex;gap:1.5rem;align-items:center;margin:1.25rem auto;padding:1.5rem;width:min(1100px,calc(100% - 2rem));box-sizing:border-box;border:1px solid #756acf66;border-radius:24px;background:linear-gradient(120deg,#1b1835,#10232b);color:#f5f6fa;font-family:Inter,system-ui,sans-serif;overflow-wrap:anywhere}
img{width:200px;height:140px;object-fit:cover;border-radius:14px}.eyebrow{font-size:.75rem;letter-spacing:.13em;text-transform:uppercase;color:#b4cff5}h2{font-size:clamp(1.3rem,3vw,2rem);line-height:1.2;margin:.5rem 0}p{line-height:1.6;color:#d1d5e4;white-space:pre-line}a{display:inline-flex;align-items:center;gap:.7rem;min-height:44px;color:#fff;font-weight:700;text-decoration:underline;text-underline-offset:5px}a:focus-visible{outline:3px solid #8ad8ff;outline-offset:5px}@media(max-width:520px){.campaign-banner{flex-direction:column;align-items:stretch;padding:1.2rem}img{width:100%;height:180px}}
</style>
