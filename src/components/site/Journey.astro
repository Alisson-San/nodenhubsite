---
/**
 * Jornada do atendimento: uma van percorre a rota conforme a rolagem e cada
 * parada mostra a etapa e a promessa ligada a ela. Junta "promessas" e
 * "como funciona" numa única seção.
 * Sem JavaScript ou com movimento reduzido, tudo aparece já percorrido.
 */
import type { Promise as NodenPromise } from "../../lib/site/divisionContent";

interface Props {
	title: string;
	steps: NodenPromise[];
	promises: NodenPromise[];
	areas?: string[];
	/** Divisão: usa a cor dela; ausente = cores da marca. */
	tone?: "brand" | "division";
	editable?: boolean;
	id?: string;
}

const { title, steps, promises, areas, tone = "brand", editable = false, id = "como-funciona" } = Astro.props;
const extraPromises = promises.slice(steps.length);
const stops = steps.map((_, index) => (index + 0.5) / steps.length);
// Rota ondulada passando pelos centros das colunas (viewBox 1000 × 140).
const horizontal = (() => {
	const xs = stops.map((s) => s * 1000);
	let d = `M 0 70`;
	xs.forEach((x, i) => {
		const prev = i === 0 ? 0 : xs[i - 1];
		const mid = (prev + x) / 2;
		const wave = i % 2 === 0 ? 18 : 122;
		d += ` C ${mid.toFixed(0)} ${wave}, ${mid.toFixed(0)} ${wave}, ${x.toFixed(0)} 70`;
	});
	d += ` C 970 ${steps.length % 2 ? 122 : 18}, 990 70, 1000 70`;
	return d;
})();
const vertical = "M 60 0 L 60 1000";
---

<section class:list={["journey", `journey--${tone}`]} aria-labelledby={`${id}-titulo`} id={id} data-journey>
	<div class="wrap">
		<h2 class="h2 journey__title" id={`${id}-titulo`}>{title}</h2>
		{editable && <div data-edit-list="promises" hidden></div>}

		<div class="journey__route" style={`--count:${steps.length}`}>
			<svg class="journey__path journey__path--h" viewBox="0 0 1000 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
				<path class="journey__track" d={horizontal} />
				<path class="journey__trail" d={horizontal} pathLength="1" data-journey-trail />
			</svg>
			<svg class="journey__path journey__path--v" viewBox="0 0 120 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false">
				<path class="journey__track" d={vertical} />
				<path class="journey__trail" d={vertical} pathLength="1" data-journey-trail />
			</svg>

			<span class="journey__van" aria-hidden="true" data-journey-van>
				<svg viewBox="0 0 72 44" focusable="false">
					<path class="van-body" d="M4 8 Q4 4 8 4 H44 Q48 4 50 7 L58 18 H64 Q68 18 68 22 V32 Q68 34 66 34 H6 Q4 34 4 32 Z" />
					<path class="van-window" d="M46 9 L54 19 H46 Z" />
					<circle class="van-ring" cx="22" cy="18" r="7" />
					<circle class="van-wheel" cx="18" cy="35" r="6" />
					<circle class="van-wheel" cx="54" cy="35" r="6" />
				</svg>
			</span>

			<ol class="journey__stops" data-edit-list={editable ? "steps" : undefined}>
				{
					steps.map((step, index) => (
						<li class="journey__stop is-reached" data-journey-stop={stops[index]}>
							<span class="journey__dot" aria-hidden="true">
								{index + 1}
							</span>
							<div class="journey__card">
								<h3>{step.title}</h3>
								<p>{step.text}</p>
								{promises[index] && (
									<p class="journey__promise">
										<svg viewBox="0 0 20 20" aria-hidden="true">
											<path d="M4 10.5 8 14.5 16 6" />
										</svg>
										<span>
											<strong>{promises[index].title}</strong>
											{promises[index].text && <small>{promises[index].text}</small>}
										</span>
									</p>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</div>

		{
			(extraPromises.length > 0 || (areas && areas.length > 0)) && (
				<div class="journey__extra">
					{extraPromises.map((promise) => (
						<span class="journey__chip">
							<strong>{promise.title}</strong> {promise.text}
						</span>
					))}
					{areas && areas.length > 0 && (
						<span class="journey__chip">
							<strong>Busca e entrega em</strong> {areas.join(" · ")}
						</span>
					)}
				</div>
			)
		}
	</div>
</section>

<script>
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	for (const root of document.querySelectorAll<HTMLElement>("[data-journey]")) {
		if (reduced) continue;
		const stops = [...root.querySelectorAll<HTMLElement>("[data-journey-stop]")];
		const van = root.querySelector<HTMLElement>("[data-journey-van]")!;
		const route = root.querySelector<HTMLElement>(".journey__route")!;
		root.classList.add("journey--live");
		let raf = 0;

		const update = () => {
			raf = 0;
			const rect = route.getBoundingClientRect();
			const vh = window.innerHeight;
			// 0 quando a rota entra pela parte de baixo da tela; 1 quando passa do meio.
			const progress = Math.min(1, Math.max(0, (vh * 0.85 - rect.top) / (rect.height + vh * 0.25)));
			const svg = [...root.querySelectorAll<SVGSVGElement>(".journey__path")].find((el) => el.getBoundingClientRect().width > 0);
			if (!svg) return;
			const trail = svg.querySelector<SVGPathElement>("[data-journey-trail]")!;
			const length = trail.getTotalLength();
			const point = trail.getPointAtLength(length * progress);
			const ahead = trail.getPointAtLength(Math.min(length, length * progress + 2));
			const view = svg.viewBox.baseVal;
			const box = svg.getBoundingClientRect();
			const x = ((point.x - view.x) / view.width) * box.width + (box.left - rect.left);
			const y = ((point.y - view.y) / view.height) * box.height + (box.top - rect.top);
			const angle = (Math.atan2(((ahead.y - point.y) / view.height) * box.height, ((ahead.x - point.x) / view.width) * box.width) * 180) / Math.PI;
			van.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) translate(-50%, -60%) rotate(${angle.toFixed(1)}deg)`;
			for (const path of root.querySelectorAll<SVGPathElement>("[data-journey-trail]")) path.style.strokeDashoffset = String(1 - progress);
			// A parada acende quando a van passa pelo ponto dela.
			const horizontalRoute = svg.classList.contains("journey__path--h");
			stops.forEach((stop) => {
				const dot = stop.querySelector<HTMLElement>(".journey__dot")!.getBoundingClientRect();
				const center = horizontalRoute ? dot.left + dot.width / 2 - rect.left : dot.top + dot.height / 2 - rect.top;
				stop.classList.toggle("is-reached", (horizontalRoute ? x : y) >= center - 4 || progress >= 0.999);
			});
		};

		const request = () => {
			if (!raf) raf = requestAnimationFrame(update);
		};
		new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting) {
				window.addEventListener("scroll", request, { passive: true });
				request();
			} else window.removeEventListener("scroll", request);
		}).observe(root);
		window.addEventListener("resize", request);
		update();
	}
</script>

<style>
	.journey {
		position: relative;
		overflow: hidden;
		padding-block: clamp(64px, 9vw, 120px);
		color: var(--white);
		background:
			radial-gradient(circle at 1px 1px, rgb(255 255 255 / 14%) 1.2px, transparent 1.6px) 0 0 / 26px 26px,
			linear-gradient(120deg, #9b2bf0 0%, #5b2bf0 45%, #2633e8 100%);
		border-bottom: var(--border);
	}
	.journey--division {
		background:
			radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--on-accent) 14%, transparent) 1.2px, transparent 1.6px) 0 0 / 26px 26px,
			var(--accent);
		color: var(--on-accent);
	}
	.journey__title {
		max-width: 18ch;
	}
	.journey__route {
		position: relative;
		margin-top: clamp(32px, 5vw, 56px);
	}
	.journey__path {
		position: absolute;
		pointer-events: none;
		overflow: visible;
	}
	.journey__path--h {
		left: 0;
		right: 0;
		top: 0;
		width: 100%;
		height: 140px;
	}
	.journey__path--v {
		display: none;
	}
	.journey__track,
	.journey__trail {
		fill: none;
		vector-effect: non-scaling-stroke;
		stroke-linecap: round;
	}
	.journey__track {
		stroke: currentColor;
		stroke-opacity: 0.35;
		stroke-width: 3;
		stroke-dasharray: 2 10;
	}
	.journey__trail {
		stroke: currentColor;
		stroke-width: 5;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}
	.journey__van {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 3;
		width: 76px;
		transform: translate(calc(100% * 0), 0);
		display: none;
		filter: drop-shadow(0 6px 0 rgb(18 14 42 / 35%));
	}
	.journey--live .journey__van {
		display: block;
	}
	.van-body {
		fill: var(--white);
		stroke: var(--ink);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.van-window {
		fill: var(--cyan);
		stroke: var(--ink);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.van-ring {
		fill: none;
		stroke: var(--violet);
		stroke-width: 4;
	}
	.van-wheel {
		fill: var(--ink);
		stroke: var(--white);
		stroke-width: 2.5;
	}
	.journey__stops {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(var(--count), minmax(0, 1fr));
		gap: 0;
	}
	.journey__stop {
		display: grid;
		justify-items: center;
		align-content: start;
		gap: 20px;
		padding-inline: 10px;
	}
	.journey__dot {
		position: relative;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		margin-top: 38px;
		border-radius: 50%;
		border: 3px solid currentColor;
		background: color-mix(in srgb, var(--ink) 30%, transparent);
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.5rem;
		transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
	}
	.journey__card {
		width: 100%;
		display: grid;
		gap: 8px;
		align-content: start;
		padding: 22px;
		border: var(--border);
		border-radius: var(--radius);
		background: var(--white);
		color: var(--ink);
		box-shadow: 6px 6px 0 var(--ink);
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.4s ease;
	}
	.journey__card h3 {
		font-size: 1.35rem;
		letter-spacing: -0.02em;
	}
	.journey__card > p {
		color: var(--ink-2);
	}
	.journey__promise {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		margin-top: 6px;
		padding: 10px 12px;
		border-radius: 12px;
		background: var(--accent-soft, #ede9fe);
	}
	.journey--brand .journey__stop:nth-child(3n + 1) .journey__promise {
		background: var(--cyan-soft);
	}
	.journey--brand .journey__stop:nth-child(3n + 2) .journey__promise {
		background: var(--indigo-soft);
	}
	.journey--brand .journey__stop:nth-child(3n + 3) .journey__promise {
		background: var(--violet-soft);
	}
	.journey__promise svg {
		width: 20px;
		height: 20px;
		flex: none;
		margin-top: 2px;
		fill: none;
		stroke: var(--ink);
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.journey__promise strong {
		display: block;
		line-height: 1.2;
	}
	.journey__promise small {
		display: block;
		color: var(--ink-2);
		font-size: 0.88rem;
		line-height: 1.35;
		margin-top: 2px;
	}

	/* Com animação: paradas ainda não alcançadas ficam em espera */
	.journey--live .journey__stop:not(.is-reached) .journey__card {
		opacity: 0.55;
		transform: translateY(14px);
	}
	.journey__stop.is-reached .journey__dot {
		background: var(--white);
		color: var(--ink);
		transform: scale(1.08);
	}
	.journey--division .journey__stop.is-reached .journey__dot {
		background: var(--on-accent);
		color: var(--accent);
	}

	.journey__extra {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 32px;
	}
	.journey__chip {
		padding: 8px 16px;
		border-radius: 999px;
		border: 2px solid currentColor;
		font-weight: 500;
	}
	.journey :focus-visible {
		outline-color: currentColor;
		box-shadow: none;
	}

	@media (max-width: 860px) {
		.journey__path--h {
			display: none;
		}
		.journey__path--v {
			display: block;
			top: 0;
			bottom: 0;
			left: 0;
			width: 120px;
			height: 100%;
		}
		.journey__stops {
			grid-template-columns: 1fr;
			gap: 28px;
			padding-left: 90px;
		}
		.journey__stop {
			padding-inline: 0;
		}
		.journey__stop {
			justify-items: start;
			position: relative;
		}
		.journey__dot {
			position: absolute;
			left: -58px;
			top: 50%;
			margin-top: -32px;
			width: 56px;
			height: 56px;
		}
		.journey__van {
			width: 56px;
		}
	}
</style>
