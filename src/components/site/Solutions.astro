---
/**
 * Explorador de serviços: abas acessíveis (setas, Home/End) com um painel
 * grande para cada serviço. Sem JavaScript, no modo de edição ou em tela
 * estreita, os serviços aparecem em lista normal.
 */
import DivisionIcon from "../common/DivisionIcon.astro";
import WhatsAppIcon from "../common/WhatsAppIcon.astro";
import { getWhatsAppUrl, siteConfig } from "../../config/site";
import { divisions } from "../../lib/site/divisions";
import type { ServiceDivision, ServiceItem } from "../../types/services";
import type { RuntimeSiteConfig } from "../../types/site";

interface Props {
	title: string;
	description: string;
	services: ServiceItem[];
	editable?: boolean;
	division?: ServiceDivision;
	site?: RuntimeSiteConfig;
}

const { title, description, services, editable = false, division, site = siteConfig } = Astro.props;
const prefix = division ? `servico-${division}` : "servico";
const ask = (service: ServiceItem) =>
	getWhatsAppUrl(`Olá! Vim pelo site${division ? ` (${divisions[division].name})` : ""} e quero saber sobre: ${service.title}.`, site);
---

<section class="solutions section" id="servicos" aria-labelledby="servicos-titulo" data-solutions>
	<div class="wrap">
		<header class="solutions__head" data-reveal>
			<p class="kicker">O que resolvemos</p>
			<h2 class="h2" id="servicos-titulo" data-edit-field="services_title">{title}</h2>
			<p class="lead" data-edit-field="services_description">{description}</p>
		</header>

		<div class="explorer">
			<div class="explorer__tabs" role="tablist" aria-label="Serviços" aria-orientation="vertical" hidden data-tabs>
				{
					services.map((service, index) => (
						<button
							type="button"
							role="tab"
							id={`${prefix}-tab-${index}`}
							aria-controls={`${prefix}-painel-${index}`}
							aria-selected={index === 0 ? "true" : "false"}
							tabindex={index === 0 ? 0 : -1}
							class="explorer__tab"
						>
							<span class="explorer__n" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
							<span class="explorer__label">{service.title}</span>
							{service.badge && <span class="explorer__badge">{service.badge}</span>}
						</button>
					))
				}
			</div>

			<ol class="explorer__panels" data-edit-collection={editable ? "service" : undefined}>
				{
					services.map((service, index) => (
						<li
							class:list={["explorer__panel", { "explorer__panel--inactive": service.inactive }]}
							id={`${prefix}-painel-${index}`}
							data-panel
							data-edit={editable ? "service" : undefined}
							data-id={service.id}
						>
							{division && (
								<svg class="explorer__mark" viewBox="-250 -250 500 500" aria-hidden="true" focusable="false">
									<DivisionIcon division={division} />
								</svg>
							)}
							<span class="explorer__big" aria-hidden="true">
								{String(index + 1).padStart(2, "0")}
							</span>
							<h3 class="explorer__title">
								{service.title}
								{service.badge && <span class="explorer__badge">{service.badge}</span>}
								{service.inactive && <span class="explorer__badge explorer__badge--hidden">Oculto do público</span>}
							</h3>
							<p class="explorer__desc">{service.description}</p>
							{service.features && service.features.length > 0 && (
								<ul class="explorer__features">
									{service.features.map((feature) => (
										<li>
											<svg viewBox="0 0 20 20" aria-hidden="true">
												<path d="M4 10.5 8 14.5 16 6" />
											</svg>
											{feature}
										</li>
									))}
								</ul>
							)}
							<div class="explorer__actions">
								<a class="btn btn--sm" href={ask(service)} target="_blank" rel="noopener">
									<WhatsAppIcon />
									Quero isso
								</a>
								<a class="btn btn--ghost btn--sm" href="#precos">
									Ver preços
								</a>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-solutions]")) {
		const tablist = root.querySelector<HTMLElement>("[data-tabs]");
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
		if (!tablist || tabs.length < 2 || document.getElementById("noden-editor-state")) continue;

		const narrow = window.matchMedia("(max-width: 860px)");
		const select = (index: number, focus = false) => {
			tabs.forEach((tab, i) => {
				const on = i === index;
				tab.setAttribute("aria-selected", String(on));
				tab.tabIndex = on ? 0 : -1;
				panels[i].hidden = !on;
				panels[i].classList.toggle("is-entering", on);
			});
			if (focus) tabs[index].focus();
		};
		const enable = () => {
			const on = !narrow.matches;
			root.classList.toggle("solutions--tabs", on);
			tablist.hidden = !on;
			panels.forEach((panel, i) => {
				panel.setAttribute("role", on ? "tabpanel" : "listitem");
				if (on) panel.setAttribute("aria-labelledby", tabs[i].id);
				else panel.removeAttribute("aria-labelledby");
				panel.tabIndex = on ? 0 : -1;
				panel.hidden = false;
			});
			if (on) select(Math.max(0, tabs.findIndex((t) => t.getAttribute("aria-selected") === "true")));
		};
		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => select(index));
			tab.addEventListener("keydown", (event) => {
				const keys: Record<string, number> = {
					ArrowDown: (index + 1) % tabs.length,
					ArrowRight: (index + 1) % tabs.length,
					ArrowUp: (index - 1 + tabs.length) % tabs.length,
					ArrowLeft: (index - 1 + tabs.length) % tabs.length,
					Home: 0,
					End: tabs.length - 1,
				};
				if (event.key in keys) {
					event.preventDefault();
					select(keys[event.key], true);
				}
			});
		});
		narrow.addEventListener("change", enable);
		enable();
	}
</script>

<style>
	.solutions__head {
		display: grid;
		gap: 16px;
		max-width: 820px;
		margin-bottom: clamp(32px, 5vw, 56px);
	}
	.explorer {
		display: grid;
		gap: 20px;
	}
	.solutions--tabs .explorer {
		grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.6fr);
		gap: 24px;
		align-items: start;
	}
	.explorer__tabs {
		display: grid;
		gap: 6px;
		position: sticky;
		top: calc(var(--header-h) + 16px);
	}
	.explorer__tab {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 14px;
		width: 100%;
		min-height: 60px;
		padding: 12px 16px;
		border: 1px solid transparent;
		border-radius: 16px;
		background: transparent;
		color: var(--text-2);
		font: 700 1.05rem/1.2 var(--font-body);
		text-align: left;
		cursor: pointer;
		transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
	}
	.explorer__tab:hover {
		background: var(--surface);
		color: var(--text);
	}
	.explorer__tab[aria-selected="true"] {
		color: var(--text);
		background: var(--surface-2);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
		box-shadow: 0 14px 40px -24px var(--accent);
	}
	.explorer__n {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--accent-text);
	}
	.explorer__panels {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 16px;
	}
	.explorer__panel {
		position: relative;
		overflow: hidden;
		display: grid;
		gap: 16px;
		align-content: start;
		padding: clamp(24px, 3vw, 40px);
		border: 1px solid var(--line);
		border-radius: calc(var(--radius) + 6px);
		background: var(--surface);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		box-shadow: var(--shadow);
	}
	.explorer__panel::before {
		content: "";
		position: absolute;
		inset: -40% -20% auto auto;
		width: 70%;
		aspect-ratio: 1;
		background: radial-gradient(circle, color-mix(in srgb, var(--accent) 35%, transparent), transparent 65%);
		filter: blur(20px);
		pointer-events: none;
	}
	.solutions--tabs .explorer__panel {
		min-height: 420px;
	}
	.explorer__panel[hidden] {
		display: none;
	}
	.explorer__panel.is-entering > * {
		animation: panel-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	.explorer__panel.is-entering > *:nth-child(3) {
		animation-delay: 0.05s;
	}
	.explorer__panel.is-entering > *:nth-child(4) {
		animation-delay: 0.1s;
	}
	.explorer__panel.is-entering > *:nth-child(5) {
		animation-delay: 0.15s;
	}
	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}
	.explorer__panel--inactive {
		opacity: 0.6;
	}
	.explorer__mark {
		position: absolute;
		right: -30px;
		bottom: -40px;
		width: 260px;
		height: 260px;
		fill: none;
		stroke: var(--accent);
		stroke-width: 10;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.12;
		pointer-events: none;
	}
	.explorer__mark :global(.fill) {
		fill: var(--accent);
		stroke: none;
	}
	.explorer__big {
		position: relative;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(3rem, 6vw, 5rem);
		line-height: 0.9;
		background: var(--grad);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.explorer__title {
		position: relative;
		font-size: clamp(1.7rem, 3vw, 2.5rem);
		letter-spacing: -0.03em;
	}
	.explorer__desc {
		position: relative;
		max-width: 52ch;
		font-size: 1.12rem;
		color: var(--text-2);
	}
	.explorer__features {
		position: relative;
		list-style: none;
		margin: 6px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		gap: 10px 20px;
	}
	.explorer__features li {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		font-weight: 600;
	}
	.explorer__features svg {
		width: 22px;
		height: 22px;
		flex: none;
		padding: 3px;
		border-radius: 50%;
		background: var(--accent-soft);
		fill: none;
		stroke: var(--accent-text);
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.explorer__actions {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 8px;
	}
	.explorer__badge {
		display: inline-block;
		vertical-align: middle;
		margin-left: 10px;
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--accent-soft);
		border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
		color: var(--accent-text);
		font-family: var(--font-body);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0;
		white-space: nowrap;
	}
	.explorer__tab .explorer__badge {
		margin-left: 0;
	}
	.explorer__badge--hidden {
		background: var(--text);
		color: var(--bg);
	}
	@media (prefers-reduced-motion: reduce) {
		.explorer__panel.is-entering > * {
			animation: none;
		}
	}
</style>
