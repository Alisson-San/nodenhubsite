---
import type { ServiceItem } from "../../types/services";

interface Props {
	title: string;
	description: string;
	services: ServiceItem[];
	editable?: boolean;
}

const { title, description, services, editable = false } = Astro.props;
---

<section class="solutions section" id="servicos" aria-labelledby="servicos-titulo">
	<div class="wrap">
		<header class="solutions__head">
			<p class="kicker">O que resolvemos</p>
			<h2 class="h2" id="servicos-titulo" data-edit-field="services_title">{title}</h2>
			<p class="lead" data-edit-field="services_description">{description}</p>
		</header>

		<ol class="solutions__list" data-edit-collection={editable ? "service" : undefined}>
			{
				services.map((service, index) => (
					<li
						class:list={["solution", { "solution--inactive": service.inactive }]}
						data-edit={editable ? "service" : undefined}
						data-id={service.id}
					>
						<span class="solution__n" aria-hidden="true">
							{String(index + 1).padStart(2, "0")}
						</span>
						<div class="solution__main">
							<h3 class="h3">
								{service.title}
								{service.badge && <span class="solution__badge">{service.badge}</span>}
								{service.inactive && <span class="solution__badge solution__badge--hidden">Oculto do público</span>}
							</h3>
							<p>{service.description}</p>
						</div>
						{service.features && service.features.length > 0 && (
							<ul class="solution__features">
								{service.features.map((feature) => (
									<li>{feature}</li>
								))}
							</ul>
						)}
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.solutions__head {
		display: grid;
		gap: 16px;
		max-width: 820px;
		margin-bottom: clamp(32px, 5vw, 56px);
	}
	.solutions__list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: var(--border);
	}
	.solution {
		display: grid;
		grid-template-columns: 80px minmax(0, 1.3fr) minmax(0, 1fr);
		gap: 16px 32px;
		padding-block: 28px;
		border-bottom: var(--border);
		align-items: start;
		position: relative;
	}
	.solution:hover .solution__n {
		background: var(--accent);
		color: var(--on-accent);
	}
	.solution--inactive {
		opacity: 0.6;
	}
	.solution__n {
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		border: var(--border);
		border-radius: 50%;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.3rem;
		transition: background 0.15s ease;
	}
	.solution__main p {
		margin-top: 10px;
		color: var(--ink-2);
		max-width: 52ch;
	}
	.solution__badge {
		display: inline-block;
		vertical-align: middle;
		margin-left: 10px;
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--accent);
		color: var(--on-accent);
		font-family: var(--font-body);
		font-size: 0.8rem;
		letter-spacing: 0;
	}
	.solution__badge--hidden {
		background: var(--ink);
		color: var(--white);
	}
	.solution__features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-content: flex-start;
	}
	.solution__features li {
		padding: 5px 12px;
		border: 1.5px solid var(--ink);
		border-radius: 999px;
		background: var(--white);
		font-size: 0.92rem;
		font-weight: 600;
	}
	@media (max-width: 860px) {
		.solution {
			grid-template-columns: 56px minmax(0, 1fr);
		}
		.solution__n {
			width: 48px;
			height: 48px;
			font-size: 1rem;
		}
		.solution__features {
			grid-column: 2;
		}
	}
</style>
