---
import { getWhatsAppUrl } from "../../config/site";
import { formatCurrency } from "../../lib/formatting";
import { divisions } from "../../lib/site/divisions";
import type { ProductDetail } from "../../lib/catalog/editorTypes";
import type { CatalogItemKind, PricingItem, ServiceDivision } from "../../types/services";
import type { RuntimeSiteConfig } from "../../types/site";

interface Props {
	site: RuntimeSiteConfig;
	division: ServiceDivision;
	title: string;
	description?: string;
	disclaimer?: string;
	items: PricingItem[];
	details?: Record<string, ProductDetail>;
	editable?: boolean;
}

const { site, division, title, description, disclaimer, items, details = {}, editable = false } = Astro.props;

const kindLabels: Record<CatalogItemKind, string> = {
	service: "Serviços",
	package: "Pacotes",
	product: "Produtos",
	consulting: "Consultoria",
};

interface Group {
	key: string;
	title: string;
	description?: string;
	items: PricingItem[];
}

const groups: Group[] = [];
for (const item of items) {
	const key = item.category?.id ?? item.category?.slug ?? `kind-${item.itemKind ?? "service"}`;
	let group = groups.find((g) => g.key === key);
	if (!group) {
		group = {
			key,
			title: item.category?.name ?? kindLabels[item.itemKind ?? "service"],
			description: item.category?.description,
			items: [],
		};
		groups.push(group);
	}
	group.items.push(item);
}

const priceText = (item: PricingItem) => {
	if (item.priceLabel) return { main: item.priceLabel };
	if (typeof item.price === "number") {
		return {
			prefix: item.pricePrefix,
			main: formatCurrency(item.price),
			suffix: item.priceSuffix,
		};
	}
	return { main: "Sob consulta" };
};

const normalize = (value: string) =>
	value.normalize("NFD").replace(/[̀-ͯ]/g, "").toLocaleLowerCase("pt-BR");

const searchText = (item: PricingItem) =>
	normalize(
		[item.name, item.description, item.category?.name, ...(item.features ?? []), ...(item.badges ?? []).map((b) => b.name)]
			.filter(Boolean)
			.join(" "),
	);

const whatsapp = (item: PricingItem) =>
	getWhatsAppUrl(
		item.ctaMessage ?? `Olá! Vim pelo site (${divisions[division].name}) e quero: ${item.name}.`,
		site,
	);

const statusLabel: Record<string, string> = { sold: "Vendido", reserved: "Reservado", unavailable: "Indisponível" };
const searchId = `catalogo-busca-${division}`;
---

<section class="catalog section" id="precos" aria-labelledby="precos-titulo" data-catalog>
	<div class="wrap">
		<header class="catalog__head">
			<div>
				<p class="kicker">Preços</p>
				<h2 class="h2" id="precos-titulo" data-edit-field="pricing_title">{title}</h2>
			</div>
			{description && <p class="lead" data-edit-field="pricing_description">{description}</p>}
		</header>

		{
			items.length > 0 && (
				<div class="catalog__tools">
					<label class="catalog__search" for={searchId}>
						<span class="sr-only">Buscar serviço</span>
						<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
						<input id={searchId} type="search" placeholder="Buscar: formatação, Wi-Fi, SSD…" autocomplete="off" data-catalog-search />
					</label>
					{
						groups.length > 1 && (
							<div class="catalog__filters" role="group" aria-label="Filtrar por categoria">
								<button type="button" class="chip" aria-pressed="true" data-catalog-filter="">Tudo</button>
								{groups.map((group) => (
									<button type="button" class="chip" aria-pressed="false" data-catalog-filter={group.key}>
										{group.title}
									</button>
								))}
							</div>
						)
					}
				</div>
			)
		}

		<p class="catalog__status" role="status" aria-live="polite" data-catalog-status></p>

		{
			groups.map((group) => (
				<div class="catalog__group" data-catalog-group={group.key}>
					<div class="catalog__group-head">
						<h3 class="h3">{group.title}</h3>
						{group.description && <p>{group.description}</p>}
					</div>
					<ul class="catalog__grid" role="list">
						{group.items.map((item) => {
							const price = priceText(item);
							const detail = item.id ? details[item.id] : undefined;
							const cover = detail?.media.find((m) => m.type === "image" && m.url.startsWith("https://"));
							const unavailable = detail && detail.status !== "available";
							return (
								<li
									class:list={["offer", { "offer--featured": item.featured, "offer--inactive": item.inactive }]}
									data-catalog-item
									data-search={searchText(item)}
									data-edit={editable ? "item" : undefined}
									data-id={item.id}
								>
									{item.inactive && <span class="offer__hidden-tag">Oculto do público</span>}
									{cover && <img class="offer__cover" src={cover.url} alt={cover.alt} loading="lazy" width="640" height="400" />}
									<div class="offer__tags">
										{item.featured && <span class="offer__tag offer__tag--strong">Destaque</span>}
										{item.tier && <span class="offer__tag">{item.tier.name}</span>}
										{(item.badges ?? []).map((badge) => (
											<span class="offer__tag">{badge.name}</span>
										))}
									</div>
									<h4 class="offer__name">{item.name}</h4>
									<p class="offer__price">
										{typeof item.compareAtPrice === "number" && typeof item.price === "number" && item.compareAtPrice > item.price && (
											<del>
												<span class="sr-only">De </span>
												{formatCurrency(item.compareAtPrice)}
											</del>
										)}
										{price.prefix && <small>{price.prefix}</small>}
										<strong>{price.main}</strong>
										{price.suffix && <small>{price.suffix}</small>}
									</p>
									<p class="offer__desc">{detail?.summary || item.description}</p>
									{item.features && item.features.length > 0 && (
										<ul class="offer__features">
											{item.features.map((feature) => (
												<li>{feature}</li>
											))}
										</ul>
									)}
									{item.note && <p class="offer__note">{item.note}</p>}
									{unavailable && <p class="offer__status">{statusLabel[detail.status]}</p>}
									<div class="offer__actions">
										<a class="btn btn--accent btn--sm" href={whatsapp(item)} target="_blank" rel="noopener">
											{item.ctaLabel ?? "Quero esse"}
										</a>
										{detail && (
											<a class="link-arrow" href={`/produtos/${detail.slug}`}>
												Ver detalhes
											</a>
										)}
									</div>
								</li>
							);
						})}
					</ul>
				</div>
			))
		}

		{items.length === 0 && <p class="catalog__empty">Os valores desta área são combinados por proposta. Chame no WhatsApp e explique a necessidade.</p>}

		<p class="catalog__empty" hidden data-catalog-empty>
			Nada encontrado com esse termo. <button type="button" class="link-arrow" data-catalog-clear>Limpar busca</button>
		</p>

		{disclaimer && <p class="catalog__disclaimer" data-edit-field="pricing_disclaimer">{disclaimer}</p>}
	</div>
</section>

<script>
	const normalize = (value: string) =>
		value.normalize("NFD").replace(/[̀-ͯ]/g, "").toLocaleLowerCase("pt-BR").trim();

	for (const root of document.querySelectorAll<HTMLElement>("[data-catalog]")) {
		const search = root.querySelector<HTMLInputElement>("[data-catalog-search]");
		const filters = [...root.querySelectorAll<HTMLButtonElement>("[data-catalog-filter]")];
		const groups = [...root.querySelectorAll<HTMLElement>("[data-catalog-group]")];
		const empty = root.querySelector<HTMLElement>("[data-catalog-empty]");
		const status = root.querySelector<HTMLElement>("[data-catalog-status]");
		let active = "";

		const apply = () => {
			const term = normalize(search?.value ?? "");
			let visible = 0;
			for (const group of groups) {
				const inGroup = !active || group.dataset.catalogGroup === active;
				let groupVisible = 0;
				for (const item of group.querySelectorAll<HTMLElement>("[data-catalog-item]")) {
					const show = inGroup && (!term || (item.dataset.search ?? "").includes(term));
					item.hidden = !show;
					if (show) groupVisible++;
				}
				group.hidden = groupVisible === 0;
				visible += groupVisible;
			}
			if (empty) empty.hidden = visible > 0;
			if (status) status.textContent = term || active ? `${visible} ${visible === 1 ? "opção encontrada" : "opções encontradas"}` : "";
		};

		search?.addEventListener("input", apply);
		for (const button of filters) {
			button.addEventListener("click", () => {
				active = button.dataset.catalogFilter ?? "";
				for (const other of filters) other.setAttribute("aria-pressed", String(other === button));
				apply();
			});
		}
		root.querySelector("[data-catalog-clear]")?.addEventListener("click", () => {
			if (search) search.value = "";
			active = "";
			for (const other of filters) other.setAttribute("aria-pressed", String(!other.dataset.catalogFilter));
			apply();
			search?.focus();
		});
	}
</script>

<style>
	.catalog {
		background:
			radial-gradient(circle at 1px 1px, rgb(18 14 42 / 9%) 1.1px, transparent 1.5px) 0 0 / 26px 26px,
			var(--accent-soft);
		border-block: var(--border);
	}
	.catalog__head {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 24px 48px;
		align-items: end;
		margin-bottom: 36px;
	}
	.catalog__head .kicker {
		margin-bottom: 14px;
	}
	.catalog__tools {
		display: grid;
		gap: 16px;
		margin-bottom: 8px;
		position: sticky;
		top: var(--header-h);
		z-index: 5;
		background: var(--accent-soft);
		padding-block: 12px;
	}
	.catalog__search {
		display: flex;
		align-items: center;
		gap: 12px;
		max-width: 560px;
		min-height: 56px;
		padding: 0 18px;
		border: var(--border);
		border-radius: 999px;
		background: var(--white);
	}
	.catalog__search svg {
		width: 22px;
		flex: none;
	}
	.catalog__search input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: transparent;
		font: inherit;
		font-size: 1.05rem;
		color: var(--ink);
		outline: none;
		min-height: 52px;
	}
	.catalog__search:focus-within {
		box-shadow: 4px 4px 0 var(--accent);
	}
	.catalog__filters {
		display: flex;
		gap: 8px;
		overflow-x: auto;
		padding-bottom: 6px;
		scrollbar-width: thin;
	}
	.catalog__filters .chip {
		flex: none;
		min-height: 44px;
		cursor: pointer;
		font: inherit;
		font-weight: 600;
		color: var(--ink);
	}
	.catalog__filters .chip[aria-pressed="true"] {
		background: var(--accent);
		color: var(--on-accent);
	}
	.catalog__status:empty {
		display: none;
	}
	.catalog__status {
		font-weight: 600;
		color: var(--muted);
		margin-top: 8px;
	}
	.catalog__group {
		margin-top: 44px;
	}
	.catalog__group[hidden] {
		display: none;
	}
	.catalog__group-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px 18px;
		padding-bottom: 14px;
		margin-bottom: 20px;
		border-bottom: var(--border);
	}
	.catalog__group-head p {
		color: var(--muted);
		max-width: 60ch;
	}
	.catalog__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 20px;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
	}
	.offer {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 24px;
		border: var(--border);
		border-radius: var(--radius);
		background: var(--white);
		min-width: 0;
		overflow-wrap: anywhere;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.offer[hidden] {
		display: none;
	}
	.offer:hover {
		transform: translate(-3px, -3px);
		box-shadow: var(--shadow);
	}
	.offer--featured {
		background: var(--accent-soft);
		box-shadow: 6px 6px 0 var(--accent);
	}
	.offer--inactive {
		opacity: 0.6;
		border-style: dashed;
	}
	.offer__hidden-tag {
		align-self: flex-start;
		font-size: 0.82rem;
		font-weight: 700;
		padding: 4px 10px;
		border-radius: 6px;
		background: var(--ink);
		color: var(--white);
	}
	.offer__cover {
		width: calc(100% + 48px);
		max-width: none;
		margin: -24px -24px 4px;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border-bottom: var(--border);
		border-radius: calc(var(--radius) - 2px) calc(var(--radius) - 2px) 0 0;
	}
	.offer__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.offer__tags:empty {
		display: none;
	}
	.offer__tag {
		font-size: 0.8rem;
		font-weight: 700;
		padding: 3px 10px;
		border: 1.5px solid var(--ink);
		border-radius: 999px;
		background: var(--white);
	}
	.offer__tag--strong {
		background: var(--ink);
		color: var(--white);
	}
	.offer__name {
		font-size: 1.4rem;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}
	.offer__price {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 8px;
	}
	.offer__price strong {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	.offer__price small {
		font-weight: 600;
		color: var(--muted);
	}
	.offer__price del {
		width: 100%;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.offer__desc {
		color: var(--ink-2);
	}
	.offer__features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 6px;
		font-size: 0.97rem;
	}
	.offer__features li {
		display: grid;
		grid-template-columns: 14px 1fr;
		gap: 10px;
	}
	.offer__features li::before {
		content: "";
		width: 12px;
		height: 12px;
		margin-top: 0.38em;
		border-radius: 50%;
		border: 3px solid var(--accent);
	}
	.offer__note,
	.offer__status {
		font-size: 0.9rem;
		color: var(--muted);
	}
	.offer__status {
		font-weight: 700;
		color: var(--ink);
	}
	.offer__actions {
		margin-top: auto;
		padding-top: 8px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 18px;
	}
	.catalog__empty {
		margin-top: 32px;
		padding: 24px;
		border: 2px dashed var(--ink);
		border-radius: var(--radius);
		font-weight: 600;
	}
	.catalog__empty[hidden] {
		display: none;
	}
	.catalog__empty button {
		background: none;
		border: 0;
		border-bottom: 2px solid currentColor;
		font: inherit;
		cursor: pointer;
		min-height: 44px;
		margin-left: 8px;
	}
	.catalog__disclaimer {
		margin-top: 40px;
		max-width: 80ch;
		font-size: 0.95rem;
		color: var(--muted);
	}
	@media (max-width: 760px) {
		.catalog__head {
			grid-template-columns: 1fr;
		}
	}
</style>
