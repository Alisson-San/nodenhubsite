---
import DivisionMark from "../common/DivisionMark.astro";
import { divisions } from "../../lib/site/divisions";
import type { ServiceDivision } from "../../types/services";

// Faixa contínua com o que cada divisão faz. Decorativa: o mesmo conteúdo
// está nas páginas das divisões.
const items: [ServiceDivision, string][] = [
	["home", "Formatação"],
	["game", "Montagem de PC gamer"],
	["data", "Dashboards e BI"],
	["home", "Wi-Fi e internet"],
	["game", "Upgrade e refrigeração"],
	["data", "Automação de processos"],
	["home", "Limpeza e manutenção"],
	["game", "Otimização de sistema"],
	["data", "Sites e plataformas"],
	["home", "Busca e entrega"],
];
---

<div class="ticker" aria-hidden="true">
	<div class="ticker__track">
		{
			[0, 1].map(() => (
				<ul>
					{items.map(([division, label]) => (
						<li data-division={division}>
							<DivisionMark division={division} size={30} />
							<span>{label}</span>
							<small>{divisions[division].name}</small>
						</li>
					))}
				</ul>
			))
		}
	</div>
</div>

<style>
	.ticker {
		overflow: hidden;
		background: var(--ink);
		color: var(--white);
		border-bottom: var(--border);
		padding-block: 16px;
	}
	.ticker__track {
		display: flex;
		width: max-content;
		animation: ticker 48s linear infinite;
	}
	.ticker:hover .ticker__track {
		animation-play-state: paused;
	}
	.ticker ul {
		display: flex;
		gap: 0;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.ticker li {
		display: flex;
		align-items: center;
		gap: 12px;
		padding-inline: 28px;
		border-right: 1px solid #3a3460;
		white-space: nowrap;
	}
	.ticker li :global(.division-mark__icon) {
		stroke: var(--white);
	}
	.ticker li :global(.division-mark__icon .fill) {
		fill: var(--white);
	}
	.ticker span {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.25rem;
	}
	.ticker small {
		color: var(--accent);
		font-weight: 700;
	}
	@keyframes ticker {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ticker__track {
			animation: none;
		}
	}
</style>
