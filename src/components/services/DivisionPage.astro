---
import PublicLayout from "../../layouts/PublicLayout.astro";
import Campaigns from "../campaigns/Campaigns.astro";
import DivisionHero from "../site/DivisionHero.astro";
import Solutions from "../site/Solutions.astro";
import Journey from "../site/Journey.astro";
import Catalog from "../site/Catalog.astro";
import ClosingCta from "../site/ClosingCta.astro";
import OtherDivisions from "../site/OtherDivisions.astro";
import InlineEditor from "../editor/InlineEditor.astro";

import { getWhatsAppUrl } from "../../config/site";
import { divisions } from "../../lib/site/divisions";
import { loadDivisionView } from "../../lib/site/divisionView";
import type { ServiceDivision } from "../../types/services";

interface Props {
	division: ServiceDivision;
}

const { division } = Astro.props;
const view = await loadDivisionView(division, Astro);

if (!view) {
	return Astro.redirect("/404", 302);
}

const { page, site, extras, details, editor } = view;
const editable = Boolean(editor);
const meta = divisions[division];

Astro.response.headers.set("X-Noden-Content-Source", view.source);
if (editable) {
	Astro.response.headers.set("Cache-Control", "private, no-store");
}
---

<PublicLayout
	site={site}
	title={page.seo.title}
	description={page.seo.description}
	canonical={page.seo.canonical}
	division={division}
	whatsappMessage={page.hero.primaryMessage}
	noindex={editable}
>
	{!editable && <Campaigns page={meta.path} />}

	<DivisionHero
		division={division}
		eyebrow={page.hero.eyebrow}
		title={page.hero.title}
		description={page.hero.description}
		highlights={page.hero.highlights}
		primaryLabel={page.hero.primaryLabel}
		primaryHref={getWhatsAppUrl(page.hero.primaryMessage, site)}
		secondaryLabel={page.hero.secondaryLabel}
		secondaryHref={page.hero.secondaryHref ?? "#precos"}
		extras={extras}
		services={page.services}
		areas={site.serviceAreas}
	/>

	<Solutions
		title={page.servicesSection.title}
		description={page.servicesSection.description}
		services={page.services}
		editable={editable}
	/>

	<Journey title="Como funciona" tone="division" steps={extras.steps} promises={extras.promises} areas={division === "data" ? undefined : site.serviceAreas} editable={editable} />

	<Catalog
		site={site}
		division={division}
		title={page.pricingSection.title}
		description={page.pricingSection.description}
		disclaimer={page.pricingSection.disclaimer}
		items={page.pricing}
		details={details}
		editable={editable}
	/>

	<ClosingCta
		title={page.cta.title}
		description={page.cta.description}
		buttonLabel={page.cta.buttonLabel}
		buttonHref={getWhatsAppUrl(page.cta.message, site)}
		secondaryLabel={page.cta.secondaryLabel}
		secondaryHref={page.cta.secondaryHref}
		division={division}
	/>

	<OtherDivisions current={division} />

	{editor && <InlineEditor slot="after" state={editor} />}
</PublicLayout>
