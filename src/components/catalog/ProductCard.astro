---
import type {RuntimeSiteConfig} from "../../types/site";
import type {PricingItem,ServiceDivision} from '../../types/services';
import type {ProductDetail} from '../../lib/catalog/editorTypes';
import {formatCurrency} from '../../lib/formatting';
import ProductDialog from './ProductDialog.astro';
interface Props {site?:RuntimeSiteConfig;item:PricingItem;detail:ProductDetail;division:ServiceDivision;preview?:boolean}
const {item,detail,division,preview=false}=Astro.props;const cover=detail.media.find(m=>m.type==='image'&&m.url.startsWith('https://'));
---
<div class="product-wrap" data-catalog-card data-kind={item.itemKind||'product'} data-search={[item.name,item.description,...(item.features||[])].join(' ').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase()}>
<article class="product-card"><div class="cover">{cover?<img src={cover.url} alt={cover.alt} loading="lazy" width="720" height="450"/>:<div class="cover-empty" aria-hidden="true"><span>◯</span><span>◯</span><span>◯</span></div>}</div><div class="content"><span class="category">{item.category?.name||'Noden '+division}</span><div class="badges">{item.tier&&<span>{item.tier.name}</span>}{(item.badges||[]).map(b=><span>{b.name}</span>)}{item.featured&&<span>Destaque</span>}</div><h4>{item.name}</h4><p>{detail.summary||item.description}</p>{typeof item.compareAtPrice==='number'&&typeof item.price==='number'&&item.compareAtPrice>item.price&&<del>{formatCurrency(item.compareAtPrice)}</del>}<div class="price">{item.priceLabel||(typeof item.price==='number'?((item.pricePrefix||'')+' '+formatCurrency(item.price)+' '+(item.priceSuffix||'')):'Sob consulta')}</div>{detail.status!=='available'&&<strong class="status">{{sold:'Vendido',reserved:'Reservado',unavailable:'Indisponível'}[detail.status]}</strong>}<a href={preview?'#product-'+(item.id||detail.slug):'/produtos/'+detail.slug} data-product-dialog={'product-'+(item.id||detail.slug)}>Explorar detalhes <span aria-hidden="true">↗</span></a></div></article>
<ProductDialog item={item} detail={detail} division={division} site={Astro.props.site} preview={preview}/>
</div>
<style>
.product-wrap{min-width:0;height:100%}.product-wrap[hidden]{display:none!important}.product-card{height:100%;display:flex;flex-direction:column;overflow:hidden;border:1px solid #314766;border-radius:23px;background:linear-gradient(145deg,#10233b,#07101f);overflow-wrap:anywhere}.cover{aspect-ratio:16/10;background:radial-gradient(ellipse at top right,#294c76,#0b1729);overflow:hidden}.cover img{width:100%;height:100%;object-fit:contain}.cover-empty{height:100%;display:flex;align-items:center;justify-content:center;color:var(--service-accent,#7abaff);font-size:70px;letter-spacing:-28px;padding-right:28px}.content{display:flex;flex:1;flex-direction:column;padding:24px}.category{font-size:.7rem;letter-spacing:.12em;color:#adc9ed}.content h4{font-size:1.5rem;font-weight:400;letter-spacing:-.04em;margin:14px 0}.content p{line-height:1.7;font-size:.9rem;color:#b0c0d5;margin:0 0 22px}.badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.badges span{font-size:.7rem;padding:5px 8px;border:1px solid #43658a;border-radius:20px;color:#c4d9f2}del{color:#bac4d4;margin-bottom:8px}.price{font-size:1.4rem;margin-top:auto;margin-bottom:18px}.status{color:#d8c196;margin-bottom:16px}.content a{display:flex;justify-content:space-between;align-items:center;min-height:46px;color:#dcecff;text-decoration:none;border-top:1px solid #344862;padding-top:12px}.content a:focus-visible{outline:2px solid #badaff;outline-offset:4px}
</style>
