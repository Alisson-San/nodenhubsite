---
import SiteLogo from "./SiteLogo.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { getWhatsAppUrl, siteConfig } from "../../config/site";
import { divisionOrder, divisions } from "../../lib/site/divisions";
import type { RuntimeSiteConfig } from "../../types/site";
import type { ServiceDivision } from "../../types/services";

interface Props {
	site?: RuntimeSiteConfig;
	current?: ServiceDivision | "start" | "links";
	whatsappMessage?: string;
}

const { site = siteConfig, current, whatsappMessage } = Astro.props;
const whatsappUrl = getWhatsAppUrl(whatsappMessage, site);
---

<header class="site-header" data-site-header>
	<div class="site-header__bar wrap">
		<SiteLogo idPrefix="header-logo" size="md" />

		<nav class="site-header__nav" aria-label="Principal">
			<ul>
				{
					divisionOrder.map((id) => (
						<li>
							<a
								href={divisions[id].path}
								data-division={id}
								aria-current={current === id ? "page" : undefined}
							>
								<span class="dot" aria-hidden="true" />
								{divisions[id].name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="site-header__actions">
			<a class="btn btn--whatsapp btn--sm site-header__cta" href={whatsappUrl} target="_blank" rel="noopener">
				<WhatsAppIcon />
				<span>Chamar no WhatsApp</span>
			</a>
			<button
				class="site-header__toggle"
				type="button"
				aria-expanded="false"
				aria-controls="site-menu"
				data-menu-toggle
			>
				<span class="sr-only" data-menu-label>Abrir menu</span>
				<span class="burger" aria-hidden="true"><span></span><span></span></span>
			</button>
		</div>
	</div>

	<div class="site-menu" id="site-menu" hidden data-menu>
		<nav class="wrap" aria-label="Menu">
			<ul>
				<li><a href="/" aria-current={current === "start" ? "page" : undefined}>Início</a></li>
				{
					divisionOrder.map((id) => (
						<li>
							<a href={divisions[id].path} data-division={id} aria-current={current === id ? "page" : undefined}>
								<span class="dot" aria-hidden="true" />
								<span>
									<strong>{divisions[id].name}</strong>
									<small>{divisions[id].audience}</small>
								</span>
							</a>
						</li>
					))
				}
				<li><a href="/links" aria-current={current === "links" ? "page" : undefined}>Todos os links</a></li>
			</ul>
			<a class="btn btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
				<WhatsAppIcon />
				Chamar no WhatsApp
			</a>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const menu = header?.querySelector<HTMLElement>("[data-menu]");
	const label = header?.querySelector<HTMLElement>("[data-menu-label]");

	if (header && toggle && menu && label) {
		const setOpen = (open: boolean, restoreFocus = false) => {
			menu.hidden = !open;
			toggle.setAttribute("aria-expanded", String(open));
			label.textContent = open ? "Fechar menu" : "Abrir menu";
			document.documentElement.classList.toggle("menu-open", open);
			if (open) menu.querySelector<HTMLElement>("a")?.focus();
			else if (restoreFocus) toggle.focus();
		};

		toggle.addEventListener("click", () => setOpen(menu.hidden !== false));
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && !menu.hidden) setOpen(false, true);
		});
		menu.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) setOpen(false);
		});
		window.matchMedia("(min-width: 960px)").addEventListener("change", (event) => {
			if (event.matches) setOpen(false);
		});

		const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
		onScroll();
		window.addEventListener("scroll", onScroll, { passive: true });
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--paper);
		border-bottom: 2px solid transparent;
		transition: border-color 0.2s ease;
	}
	.site-header.is-scrolled,
	:global(.menu-open) .site-header {
		border-bottom-color: var(--ink);
	}
	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: var(--header-h);
	}
	.site-header__nav ul {
		display: flex;
		gap: 6px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.site-header__nav a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 14px;
		border: 2px solid transparent;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
	}
	.site-header__nav a:hover {
		border-color: var(--ink);
	}
	.site-header__nav a[aria-current="page"] {
		background: var(--accent);
		color: var(--on-accent);
		border-color: var(--ink);
	}
	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 3px solid var(--accent);
		flex: none;
	}
	[aria-current="page"] > .dot {
		border-color: currentColor;
	}
	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.site-header__toggle {
		display: none;
		width: 48px;
		height: 48px;
		border: var(--border);
		border-radius: 50%;
		background: var(--white);
		cursor: pointer;
		place-items: center;
	}
	.burger {
		display: grid;
		gap: 6px;
		width: 20px;
	}
	.burger span {
		height: 2.5px;
		background: var(--ink);
		border-radius: 2px;
		transition: transform 0.2s ease;
	}
	[aria-expanded="true"] .burger span:first-child {
		transform: translateY(4.25px) rotate(45deg);
	}
	[aria-expanded="true"] .burger span:last-child {
		transform: translateY(-4.25px) rotate(-45deg);
	}

	.site-menu {
		border-top: var(--border);
		background: var(--paper);
		max-height: calc(100dvh - var(--header-h));
		overflow-y: auto;
		padding-block: 20px 28px;
	}
	.site-menu ul {
		list-style: none;
		margin: 0 0 20px;
		padding: 0;
		display: grid;
	}
	.site-menu li a {
		display: flex;
		align-items: center;
		gap: 14px;
		min-height: 60px;
		padding: 10px 4px;
		border-bottom: 2px solid var(--line-soft);
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 700;
		text-decoration: none;
	}
	.site-menu li a small {
		display: block;
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--muted);
	}
	.site-menu li a .dot {
		width: 18px;
		height: 18px;
		border-width: 4px;
	}
	.site-menu li a[aria-current="page"] {
		color: var(--accent-text);
	}
	.site-menu .btn {
		width: 100%;
	}

	@media (max-width: 959px) {
		.site-header__nav {
			display: none;
		}
		.site-header__toggle {
			display: grid;
		}
	}
	@media (max-width: 520px) {
		.site-header__cta span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
		}
		.site-header__cta {
			width: 48px;
			padding: 0;
		}
	}
</style>
