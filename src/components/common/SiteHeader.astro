---
import SiteLogo from "./SiteLogo.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import DivisionMark from "./DivisionMark.astro";
import SocialIcon from "./SocialIcon.astro";
import { getWhatsAppUrl, siteConfig } from "../../config/site";
import { divisionOrder, divisions } from "../../lib/site/divisions";
import type { RuntimeSiteConfig } from "../../types/site";
import type { ServiceDivision } from "../../types/services";

interface Props {
	site?: RuntimeSiteConfig;
	current?: ServiceDivision | "start" | "links";
	whatsappMessage?: string;
}

const { site = siteConfig, current, whatsappMessage } = Astro.props;
const whatsappUrl = getWhatsAppUrl(whatsappMessage, site);
const socials = site.socialLinks.filter((link) => link.isActive && link.platform !== "whatsapp" && link.platform !== "website");
---

<header class="site-header" data-site-header>
	<div class="site-header__bar wrap">
		<SiteLogo idPrefix="header-logo" size="md" />

		<nav class="site-header__nav" aria-label="Principal">
			<ul>
				{
					divisionOrder.map((id) => (
						<li>
							<a
								href={divisions[id].path}
								data-division={id}
								aria-current={current === id ? "page" : undefined}
							>
								<DivisionMark division={id} size={26} />
								{divisions[id].name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="site-header__actions">
			<a class="btn btn--whatsapp btn--sm site-header__cta" href={whatsappUrl} target="_blank" rel="noopener">
				<WhatsAppIcon />
				<span>Chamar no WhatsApp</span>
			</a>
			<button
				class="site-header__toggle"
				type="button"
				aria-expanded="false"
				aria-controls="site-menu"
				data-menu-toggle
			>
				<span class="sr-only" data-menu-label>Abrir menu</span>
				<span class="burger" aria-hidden="true"><span></span><span></span></span>
			</button>
		</div>
	</div>

	<div class="site-menu" id="site-menu" hidden data-menu>
		<nav class="wrap" aria-label="Menu">
			<ul>
				<li><a href="/" aria-current={current === "start" ? "page" : undefined}>Início</a></li>
				{
					divisionOrder.map((id) => (
						<li>
							<a href={divisions[id].path} data-division={id} aria-current={current === id ? "page" : undefined}>
								<DivisionMark division={id} size={44} />
								<span>
									<strong>{divisions[id].name}</strong>
									<small>{divisions[id].audience}</small>
								</span>
							</a>
						</li>
					))
				}
				<li><a href="/links" aria-current={current === "links" ? "page" : undefined}>Todos os links</a></li>
			</ul>
			<a class="btn btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
				<WhatsAppIcon />
				Chamar no WhatsApp
			</a>
			{
				socials.length > 0 && (
					<ul class="site-menu__social" aria-label="Redes sociais">
						{socials.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener" aria-label={link.label}>
									<SocialIcon platform={link.platform} />
								</a>
							</li>
						))}
					</ul>
				)
			}
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const menu = header?.querySelector<HTMLElement>("[data-menu]");
	const label = header?.querySelector<HTMLElement>("[data-menu-label]");

	if (header && toggle && menu && label) {
		const setOpen = (open: boolean, restoreFocus = false) => {
			menu.hidden = !open;
			toggle.setAttribute("aria-expanded", String(open));
			label.textContent = open ? "Fechar menu" : "Abrir menu";
			document.documentElement.classList.toggle("menu-open", open);
			if (open) menu.querySelector<HTMLElement>("a")?.focus();
			else if (restoreFocus) toggle.focus();
		};

		toggle.addEventListener("click", () => setOpen(menu.hidden !== false));
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && !menu.hidden) setOpen(false, true);
		});
		menu.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) setOpen(false);
		});
		window.matchMedia("(min-width: 960px)").addEventListener("change", (event) => {
			if (event.matches) setOpen(false);
		});

		const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
		onScroll();
		window.addEventListener("scroll", onScroll, { passive: true });
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--bg) 62%, transparent);
		backdrop-filter: blur(18px) saturate(150%);
		-webkit-backdrop-filter: blur(18px) saturate(150%);
		border-bottom: 1px solid transparent;
		transition: border-color 0.25s ease, background 0.25s ease;
	}
	.site-header.is-scrolled,
	:global(.menu-open) .site-header {
		border-bottom-color: var(--line);
		background: color-mix(in srgb, var(--bg) 82%, transparent);
	}
	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: var(--header-h);
	}
	.site-header :global(.site-logo) {
		color: var(--text);
	}
	.site-header__nav ul {
		display: flex;
		gap: 4px;
		padding: 4px;
		list-style: none;
		margin: 0;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
	}
	.site-header__nav a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 40px;
		padding: 0 14px 0 8px;
		border-radius: 999px;
		color: var(--text-2);
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.site-header__nav a:hover {
		color: var(--text);
		background: var(--surface-2);
	}
	.site-header__nav a[aria-current="page"] {
		color: var(--text);
		background: var(--accent-soft);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 55%, transparent);
	}
	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.site-header__toggle {
		display: none;
		width: 46px;
		height: 46px;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
		background: var(--surface);
		cursor: pointer;
		place-items: center;
	}
	.burger {
		display: grid;
		gap: 6px;
		width: 20px;
	}
	.burger span {
		height: 2px;
		background: var(--text);
		border-radius: 2px;
		transition: transform 0.2s ease;
	}
	[aria-expanded="true"] .burger span:first-child {
		transform: translateY(4px) rotate(45deg);
	}
	[aria-expanded="true"] .burger span:last-child {
		transform: translateY(-4px) rotate(-45deg);
	}

	.site-menu {
		border-top: 1px solid var(--line);
		max-height: calc(100dvh - var(--header-h));
		overflow-y: auto;
		padding-block: 16px 28px;
	}
	.site-menu ul {
		list-style: none;
		margin: 0 0 20px;
		padding: 0;
		display: grid;
	}
	.site-menu li a {
		display: flex;
		align-items: center;
		gap: 14px;
		min-height: 60px;
		padding: 10px 4px;
		border-bottom: 1px solid var(--line);
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--text);
	}
	.site-menu li a small {
		display: block;
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-2);
	}
	.site-menu li a[aria-current="page"] strong {
		color: var(--accent-text);
	}
	.site-menu .btn {
		width: 100%;
	}
	.site-menu ul.site-menu__social {
		display: flex;
		gap: 10px;
		margin: 18px 0 0;
	}
	.site-menu__social a {
		display: grid !important;
		place-items: center;
		width: 48px;
		height: 48px;
		min-height: 0 !important;
		padding: 0 !important;
		border: 1px solid var(--line-strong) !important;
		border-radius: 50%;
	}

	@media (max-width: 959px) {
		.site-header__nav {
			display: none;
		}
		.site-header__toggle {
			display: grid;
		}
	}
	@media (max-width: 520px) {
		.site-header__cta span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
		}
		.site-header__cta {
			width: 46px;
			padding: 0;
		}
	}
</style>
