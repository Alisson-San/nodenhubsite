---
import SiteLogo from "./SiteLogo.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import DivisionMark from "./DivisionMark.astro";
import { getWhatsAppUrl, siteConfig } from "../../config/site";
import { divisionOrder, divisions } from "../../lib/site/divisions";
import type { RuntimeSiteConfig } from "../../types/site";

interface Props {
	site?: RuntimeSiteConfig;
}

const { site = siteConfig } = Astro.props;
const year = new Date().getFullYear();
const socials = site.socialLinks.filter((link) => link.isActive && link.platform !== "website");
---

<footer class="site-footer">
	<div class="wrap site-footer__grid">
		<div class="site-footer__brand">
			<SiteLogo idPrefix="footer-logo" size="lg" inverse />
			<p>Tecnologia resolvida para casa, setup gamer e empresa. {site.serviceAreas.join(", ")}.</p>
			<a class="btn btn--whatsapp" href={getWhatsAppUrl(undefined, site)} target="_blank" rel="noopener">
				<WhatsAppIcon />
				{site.phone || "Chamar no WhatsApp"}
			</a>
		</div>

		<nav aria-label="Divisões">
			<h2>Divisões</h2>
			<ul>
				{
					divisionOrder.map((id) => (
						<li data-division={id}>
							<a href={divisions[id].path}>
								<DivisionMark division={id} size={28} inverse />
								{divisions[id].name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div>
			<h2>Contato</h2>
			<ul>
				{socials.map((link) => (
					<li><a href={link.url} target="_blank" rel="noopener">{link.label}{link.username ? ` · ${link.username}` : ""}</a></li>
				))}
				{site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
				<li><a href="/links">Todos os links</a></li>
			</ul>
			<p class="site-footer__hours">{site.serviceHours}</p>
		</div>
	</div>

	<div class="wrap site-footer__bottom">
		<span>© {year} {site.legalName}</span>
		<a href="/admin">Área restrita</a>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: #e9e7f5;
		padding-top: clamp(48px, 7vw, 88px);
		position: relative;
	}
	.site-footer::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 8px;
		background: var(--brand-gradient);
	}
	.site-footer__grid {
		display: grid;
		gap: 40px;
		grid-template-columns: 1.4fr 1fr 1fr;
	}
	.site-footer__brand p {
		margin: 18px 0 24px;
		max-width: 36ch;
		color: #c9c5df;
	}
	.site-footer h2 {
		font-size: 1rem;
		font-family: var(--font-body);
		letter-spacing: 0;
		color: #a9a4c6;
		margin-bottom: 12px;
	}
	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
	}
	.site-footer li a {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		text-decoration: none;
		font-weight: 600;
	}
	.site-footer li a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.site-footer .dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 3px solid var(--accent);
	}
	.site-footer__hours {
		margin-top: 12px;
		color: #a9a4c6;
		font-size: 0.95rem;
	}
	.site-footer :focus-visible {
		outline-color: var(--white);
		box-shadow: none;
	}
	.site-footer__bottom {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		margin-top: 48px;
		padding-block: 20px 28px;
		border-top: 1px solid #36305a;
		font-size: 0.9rem;
		color: #a9a4c6;
	}
	.site-footer__bottom a {
		color: #a9a4c6;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	@media (max-width: 860px) {
		.site-footer__grid {
			grid-template-columns: 1fr 1fr;
		}
		.site-footer__brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
