---
import SiteLogo from "./SiteLogo.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import DivisionMark from "./DivisionMark.astro";
import SocialIcon from "./SocialIcon.astro";
import { getWhatsAppUrl, siteConfig } from "../../config/site";
import { divisionOrder, divisions } from "../../lib/site/divisions";
import type { RuntimeSiteConfig } from "../../types/site";

interface Props {
	site?: RuntimeSiteConfig;
}

const { site = siteConfig } = Astro.props;
const year = new Date().getFullYear();
const socials = site.socialLinks.filter((link) => link.isActive && link.platform !== "website");
const phoneHref = site.phone ? `tel:${site.phone.replace(/[^\d+]/g, "")}` : "";
---

<footer class="site-footer">
	<div class="site-footer__glow" aria-hidden="true"></div>
	<div class="wrap site-footer__grid">
		<div class="site-footer__brand">
			<SiteLogo idPrefix="footer-logo" size="lg" inverse />
			<p>Tecnologia resolvida para casa, setup gamer e empresa. {site.serviceAreas.join(", ")}.</p>
			<a class="btn btn--whatsapp" href={getWhatsAppUrl(undefined, site)} target="_blank" rel="noopener">
				<WhatsAppIcon />
				Chamar no WhatsApp
			</a>
			{
				socials.length > 0 && (
					<ul class="site-footer__social" aria-label="Redes sociais">
						{socials.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener" aria-label={`${link.label}${link.username ? ` (${link.username})` : ""}`}>
									<SocialIcon platform={link.platform} />
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>

		<nav aria-label="Divisões">
			<h2>Divisões</h2>
			<ul>
				{
					divisionOrder.map((id) => (
						<li data-division={id}>
							<a href={divisions[id].path}>
								<DivisionMark division={id} size={28} />
								<span>
									{divisions[id].name}
									<small>{divisions[id].audience}</small>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div>
			<h2>Contato</h2>
			<ul>
				{socials.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener">
							<SocialIcon platform={link.platform} size={18} />
							{link.username || link.label}
						</a>
					</li>
				))}
				{
					phoneHref && (
						<li>
							<a href={phoneHref}>
								<SocialIcon platform="phone" size={18} />
								{site.phone}
							</a>
						</li>
					)
				}
				{
					site.email && (
						<li>
							<a href={`mailto:${site.email}`}>
								<SocialIcon platform="email" size={18} />
								{site.email}
							</a>
						</li>
					)
				}
				<li>
					<a href="/links">
						<SocialIcon platform="website" size={18} />
						Todos os links
					</a>
				</li>
			</ul>
			<p class="site-footer__hours">{site.serviceHours}</p>
		</div>
	</div>

	<div class="wrap site-footer__bottom">
		<span>© {year} {site.legalName}</span>
		<a href="/admin">Área restrita</a>
	</div>
</footer>

<style>
	.site-footer {
		--text: #f4f2ff;
		--text-2: #b6b0d6;
		--line: rgb(255 255 255 / 12%);
		position: relative;
		overflow: hidden;
		background: #05040f;
		color: var(--text);
		padding-top: clamp(56px, 8vw, 96px);
	}
	.site-footer__glow {
		position: absolute;
		inset: -40% -10% auto;
		height: 70%;
		background:
			radial-gradient(40% 60% at 20% 100%, rgb(178 49 251 / 28%), transparent 70%),
			radial-gradient(40% 60% at 55% 100%, rgb(45 47 252 / 26%), transparent 70%),
			radial-gradient(40% 60% at 90% 100%, rgb(1 204 254 / 20%), transparent 70%);
		pointer-events: none;
	}
	.site-footer::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: var(--brand-gradient);
		opacity: 0.8;
	}
	.site-footer__grid {
		position: relative;
		display: grid;
		gap: 40px;
		grid-template-columns: 1.4fr 1fr 1fr;
	}
	.site-footer__brand p {
		margin: 18px 0 24px;
		max-width: 36ch;
		color: var(--text-2);
	}
	.site-footer h2 {
		font-size: 0.95rem;
		font-family: var(--font-body);
		letter-spacing: 0;
		color: var(--text-2);
		margin-bottom: 12px;
	}
	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
	}
	.site-footer li a {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		min-height: 44px;
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
	}
	.site-footer li a small {
		display: block;
		color: var(--text-2);
		font-weight: 500;
		font-size: 0.85rem;
	}
	.site-footer li a:hover {
		color: #ffffff;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.site-footer__social {
		display: flex !important;
		gap: 10px !important;
		margin-top: 22px !important;
	}
	.site-footer__social a {
		justify-content: center;
		width: 46px;
		height: 46px;
		border: 1px solid rgb(255 255 255 / 20%);
		border-radius: 50%;
		background: rgb(255 255 255 / 5%);
		transition: background 0.2s ease, transform 0.2s ease;
	}
	.site-footer__social a:hover {
		background: rgb(255 255 255 / 12%);
		transform: translateY(-2px);
		text-decoration: none;
	}
	.site-footer__hours {
		margin-top: 12px;
		color: var(--text-2);
		font-size: 0.95rem;
	}
	.site-footer :focus-visible {
		outline-color: #ffffff;
	}
	.site-footer__bottom {
		position: relative;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-top: 48px;
		padding-block: 16px 28px;
		border-top: 1px solid var(--line);
		font-size: 0.9rem;
		color: var(--text-2);
	}
	.site-footer__bottom a {
		color: var(--text-2);
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	@media (max-width: 860px) {
		.site-footer__grid {
			grid-template-columns: 1fr 1fr;
		}
		.site-footer__brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
