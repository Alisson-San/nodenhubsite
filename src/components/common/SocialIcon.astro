---
/**
 * Ícones das redes e canais de contato, no mesmo estilo de traço (grade 24).
 * Plataformas sem ícone próprio usam o globo.
 */
interface Props {
	platform: string;
	size?: number;
	class?: string;
}

const { platform, size = 22, class: className = "" } = Astro.props;
const key = platform.toLowerCase().replace(/[^a-z]/g, "");
const known = ["instagram", "whatsapp", "facebook", "tiktok", "youtube", "linkedin", "telegram", "x", "twitter", "phone", "email", "mail", "website", "site"];
const icon = known.includes(key) ? key : "website";
---

<svg
	class:list={["social-icon", className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	aria-hidden="true"
	focusable="false"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	{
		icon === "instagram" && (
			<>
				<rect x="3" y="3" width="18" height="18" rx="5" />
				<circle cx="12" cy="12" r="4" />
				<circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		icon === "whatsapp" && (
			<>
				<path d="M4.5 19.5 5.6 15.7A8 8 0 1 1 8.6 18.6Z" />
				<path d="M9.2 8.3c.3-.6.8-.6 1.1-.1l.7 1.5c.1.3 0 .6-.2.8l-.5.5c.4 1 1.3 1.9 2.4 2.4l.5-.5c.2-.2.5-.3.8-.2l1.5.7c.5.3.5.8-.1 1.1-1.1.7-2.6.5-4.3-.8-1.5-1.2-2.5-2.6-2.6-3.8 0-.6.2-1.1.7-1.6Z" fill="currentColor" stroke="none" />
			</>
		)
	}
	{icon === "facebook" && <path d="M14.5 21v-7.5H17l.5-3h-3V8.8c0-.9.4-1.5 1.6-1.5H17.6V4.6c-.5-.1-1.4-.2-2.4-.2-2.4 0-3.8 1.4-3.8 3.9v2.2H8.8v3h2.6V21" />}
	{
		icon === "tiktok" && (
			<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2 4.3 4.6 4.6" />
		)
	}
	{
		icon === "youtube" && (
			<>
				<rect x="2.5" y="5.5" width="19" height="13" rx="4" />
				<path d="m10.2 9.3 4.6 2.7-4.6 2.7Z" fill="currentColor" />
			</>
		)
	}
	{
		icon === "linkedin" && (
			<>
				<rect x="3" y="3" width="18" height="18" rx="3" />
				<path d="M8 10.5V17M8 7.4v.1M11.5 17v-3.6c0-1.8 1-2.9 2.4-2.9s2.1 1 2.1 2.8V17M11.5 10.5V17" />
			</>
		)
	}
	{icon === "telegram" && <path d="m3.5 11.3 16-6.2c.7-.3 1.4.3 1.2 1.1l-2.7 12.7c-.2.8-1.1 1.1-1.7.6l-4.3-3.2-2.2 2.1c-.3.3-.8.1-.8-.3v-3.4l7.3-6.6-9 5.6-3.7-1.2c-.8-.2-.8-1.1-.1-1.2Z" />}
	{(icon === "x" || icon === "twitter") && <path d="M4 4l16 16M20 4 4 20" />}
	{icon === "phone" && <path d="M6.6 3.5h2.6l1.4 4-2 1.3a11 11 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2C10.4 18.9 5.1 13.6 4.6 5.7a2 2 0 0 1 2-2.2Z" />}
	{
		(icon === "email" || icon === "mail") && (
			<>
				<rect x="3" y="5" width="18" height="14" rx="3" />
				<path d="m4 7 8 6 8-6" />
			</>
		)
	}
	{
		(icon === "website" || icon === "site") && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3Z" />
			</>
		)
	}
</svg>

<style>
	.social-icon {
		flex: none;
		display: inline-block;
	}
</style>
