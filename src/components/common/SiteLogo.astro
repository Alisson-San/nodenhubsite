---
import NodenMarkStatic from "../NodenMarkStatic-conectores-visiveis.astro";
import { siteConfig } from "../../config/site";

interface Props {
	href?: string;
	size?: "sm" | "md" | "lg";
	idPrefix?: string;
	class?: string;
	/** Use em fundos escuros. */
	inverse?: boolean;
}

const {
	href = "/",
	size = "md",
	idPrefix = "site-logo",
	class: className = "",
	inverse = false,
} = Astro.props;

const Tag = href ? "a" : "span";
---

<Tag
	class:list={["site-logo", className, { "site-logo--inverse": inverse }]}
	data-size={size}
	href={href || undefined}
	aria-label={href ? `${siteConfig.name} — página inicial` : siteConfig.name}
>
	<span class="site-logo__wordmark" aria-hidden="true">
		<span>N</span>
		<span class="site-logo__mark">
			<NodenMarkStatic idPrefix={idPrefix} decorative={true} />
		</span>
		<span>DEN</span>
	</span>
</Tag>

<style>
	.site-logo {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
		text-decoration: none;
		min-height: 44px;
	}
	.site-logo--inverse {
		color: var(--white);
	}
	.site-logo__wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.08em;
		font-family: var(--font-display);
		font-weight: 800;
		letter-spacing: 0.04em;
		line-height: 1;
	}
	.site-logo__mark {
		display: inline-flex;
		width: 1.15em;
		height: 1.15em;
		flex-shrink: 0;
	}
	.site-logo__mark :global(svg) {
		width: 100%;
		height: 100%;
	}
	.site-logo[data-size="sm"] .site-logo__wordmark {
		font-size: 1.1rem;
	}
	.site-logo[data-size="md"] .site-logo__wordmark {
		font-size: 1.45rem;
	}
	.site-logo[data-size="lg"] .site-logo__wordmark {
		font-size: 2.2rem;
	}
</style>
